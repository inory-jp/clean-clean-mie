---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/home/Hero.astro";
import FirstTimeOffer from "../components/home/FirstTimeOffer.astro";
import UrgencyBanner from "../components/home/UrgencyBanner.astro";
import TrustBar from "../components/home/TrustBar.astro";
import Strengths from "../components/home/Strengths.astro";
import OwnerIntro from "../components/home/OwnerIntro.astro";
import Promises from "../components/home/Promises.astro";
import Services from "../components/home/Services.astro";
import Compare from "../components/home/Compare.astro";
import Flow from "../components/home/Flow.astro";
import Voices from "../components/home/Voices.astro";
import Programs from "../components/home/Programs.astro";
import News from "../components/home/News.astro";
import FaqPreview from "../components/home/FaqPreview.astro";
import Area from "../components/home/Area.astro";
import FinalCTA from "../components/home/FinalCTA.astro";
import site from "../data/site.json";
---

<Layout
  title={`${site.brand_kana}（CLEAN×CLEAN）津中央店｜津市のエアコンクリーニング`}
  description={`CLEAN×CLEAN（${site.brand_kana}）津中央店は、津市・松阪市・鈴鹿市を中心に三重県全域へ出張。エアコンクリーニングや浴室・換気扇などのハウスクリーニングを、店主が直接施工します。`}
  showNotice={true}
>
  <Hero />
  <UrgencyBanner />
  <FirstTimeOffer />
  <TrustBar />
  <Strengths />
  <OwnerIntro />
  <Promises />
  <Services />
  <Compare />
  <Flow />
  <Voices />
  <Programs />
  <News />
  <FaqPreview />
  <Area />
  <FinalCTA />
</Layout>
