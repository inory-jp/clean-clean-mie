---
import Layout from "../layouts/Layout.astro";
import site from "../data/site.json";

const companyInfo = [
  { label: "屋号", value: site.business_name },
  { label: "代表者", value: `${site.representative}（${site.representative_kana}）` },
  { label: "所在地", value: `〒${site.postal_code} ${site.address}` },
  { label: "電話", value: site.tel },
  { label: "携帯", value: site.mobile },
  { label: "メール", value: site.email },
  { label: "営業時間", value: site.hours },
  { label: "定休日", value: site.holiday },
  { label: "対応エリア", value: site.service_area },
  { label: "加盟保険", value: site.insurance },
];

const strengths = [
  {
    no: "01",
    title: "ありがとうの輪を広げる",
    body: "お客様からの「ありがとう」が原動力。一軒一軒に丁寧に向き合い、笑顔の連鎖を地域に広げていきます。",
  },
  {
    no: "02",
    title: "下請けに出さない",
    body: "ご依頼は店主・栗田が自らの手で。顔の見える施工と、ご家庭ごとに合わせた最適な作業をお約束します。",
  },
  {
    no: "03",
    title: "地域密着",
    body: "津市・松阪市・鈴鹿市を中心に三重県全域へ。地元だからこそできる迅速な対応と長くお付き合いできる関係づくりを大切にします。",
  },
];
---

<Layout
  title="会社概要・店主紹介｜CLEAN×CLEAN 津中央店"
  description="CLEAN×CLEAN 津中央店の会社概要と店主紹介。代表 栗田祐志（宅地建物取引士）。三重県津市・松阪市・鈴鹿市を中心に対応するハウスクリーニング店です。"
>
  <section class="bg-gradient-to-b from-sky-mist to-white py-16 md:py-20">
    <div class="max-w-5xl mx-auto px-4 md:px-8 text-center">
      <span class="label-en">ABOUT US</span>
      <h1 class="text-3xl md:text-5xl font-black text-text mt-3">
        会社概要・<span class="text-navy">店主紹介</span>
      </h1>
      <p class="mt-6 text-text-soft max-w-2xl mx-auto leading-relaxed">
        地域に根ざした、店主直接施工のハウスクリーニング。<br
          class="hidden sm:inline"
        />顔の見える安心と、ありがとうの輪を、三重県の暮らしへ。
      </p>
    </div>
  </section>

  <section class="py-16 md:py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 md:px-8">
      <div class="text-center mb-10">
        <span class="label-en">COMPANY</span>
        <h2 class="text-2xl md:text-3xl font-black text-text mt-2">会社情報</h2>
      </div>
      <div class="bg-bg-soft rounded-2xl border border-line-soft overflow-hidden">
        <table class="w-full text-sm">
          {
            companyInfo.map((row, i) => (
              <tr class={i > 0 ? "border-t border-line-soft" : ""}>
                <th class="bg-sky-pale text-navy-deep text-left px-5 py-4 w-32 sm:w-40 font-bold align-top">
                  {row.label}
                </th>
                <td class="px-5 py-4 text-text">{row.value}</td>
              </tr>
            ))
          }
        </table>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-20 bg-bg-soft">
    <div class="max-w-4xl mx-auto px-4 md:px-8">
      <div class="text-center mb-10">
        <span class="label-en">REPRESENTATIVE</span>
        <h2 class="text-2xl md:text-3xl font-black text-text mt-2">
          店主<span class="text-navy">ごあいさつ</span>
        </h2>
      </div>

      <div class="bg-white rounded-2xl border border-line-soft p-6 md:p-10 grid md:grid-cols-3 gap-8 items-start">
        <div class="text-center">
          <div
            class="w-40 h-40 mx-auto rounded-full bg-sky-pale flex items-center justify-center text-7xl"
          >
            👨‍🔧
          </div>
          <div class="mt-4 font-black text-lg text-text">栗田 祐志</div>
          <div class="text-xs text-muted">くりた ゆうじ</div>
          <div class="mt-4 flex flex-wrap gap-1.5 justify-center">
            <span class="text-[10px] bg-navy text-white px-2 py-1 rounded-full font-bold">
              宅地建物取引士
            </span>
            <span class="text-[10px] bg-sky text-white px-2 py-1 rounded-full font-bold">
              元おそうじ本舗
            </span>
          </div>
        </div>

        <div class="md:col-span-2">
          <p class="text-text-soft leading-relaxed">
            はじめまして、CLEAN×CLEAN 津中央店の栗田です。<br /><br />
            長年お世話になってきたハウスクリーニングの世界で、お客様からいただく「ありがとう」のひと言こそが、何よりの励みでした。<br
            /><br />
            だからこそ私は、下請けには出さず、店主である私が直接、責任を持って施工いたします。一軒一軒のご家庭に丁寧に向き合い、お引渡しの瞬間に笑顔を交わせる。<br
            /><br />
            そんな仕事を、地元・津からお届けしていきます。
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-20 bg-white">
    <div class="max-w-5xl mx-auto px-4 md:px-8">
      <div class="text-center mb-10">
        <span class="label-en">OUR PHILOSOPHY</span>
        <h2 class="text-2xl md:text-3xl font-black text-text mt-2">
          私たちが大切にしている<span class="text-navy">3つのこと</span>
        </h2>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {
          strengths.map((s) => (
            <div class="bg-bg-soft rounded-2xl p-7 border border-line-soft">
              <div class="num-mont text-5xl text-sky-light">{s.no}</div>
              <h3 class="mt-3 font-black text-text text-lg">{s.title}</h3>
              <p class="mt-3 text-text-soft text-sm leading-relaxed">{s.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-bg-soft py-16">
    <div class="max-w-3xl mx-auto px-4 md:px-8">
      <div class="text-center mb-8">
        <span class="label-en">STORE LOCATION</span>
        <h2 class="text-2xl md:text-3xl font-black text-text mt-2">店舗情報</h2>
      </div>
      <div class="bg-white rounded-2xl border border-line-soft overflow-hidden">
        <iframe
          src="https://www.google.com/maps?q=三重県津市上浜町3-15-2&output=embed"
          loading="lazy"
          class="w-full h-72 border-0"
          title="CLEAN×CLEAN 津中央店 地図"
        ></iframe>
        <div class="p-6 grid sm:grid-cols-2 gap-4 text-sm">
          <div>
            <div class="text-xs text-muted font-bold mb-1">所在地</div>
            <div class="text-text">〒{site.postal_code}<br />{site.address}</div>
          </div>
          <div>
            <div class="text-xs text-muted font-bold mb-1">営業時間</div>
            <div class="text-text">{site.hours}<br />（{site.holiday}）</div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
