---
import Layout from "../../layouts/Layout.astro";
import menusData from "../../data/menus.json";

export function getStaticPaths() {
  return menusData.categories.map((c) => ({
    params: { slug: c.slug },
    props: { category: c },
  }));
}

const { category } = Astro.props;
const formatPrice = (n: number | null, label?: string) =>
  n != null ? `¥${n.toLocaleString()}` : (label ?? "要問合せ");

const title = `${category.name}｜CLEAN×CLEAN 津中央店`;
const description = `津市・松阪市・鈴鹿市を中心に対応する${category.name}。${category.tagline}。料金${formatPrice(category.starting_price)}〜（税込）、所要${category.duration}、損害保険完備で安心。`;
---

<Layout title={title} description={description}>
  <section class="bg-gradient-to-br from-sky-mist via-sky-pale to-white py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-4 md:px-8 grid md:grid-cols-2 gap-8 items-center">
      <div>
        <a href="/service" class="text-navy text-sm font-bold hover:underline">
          ← サービス一覧へ戻る
        </a>
        <span class="label-en mt-4 block">{category.slug.toUpperCase()} CLEANING</span>
        <h1 class="mt-3 text-3xl md:text-5xl font-black text-text leading-tight">
          {category.name}
        </h1>
        <p class="mt-2 text-navy font-bold">{category.tagline}</p>
        <p class="mt-5 text-text-soft leading-relaxed">{category.lead}</p>

        <div class="mt-7 flex flex-wrap gap-3">
          <div class="bg-white rounded-xl px-4 py-3 border border-line-soft">
            <div class="text-[10px] text-muted font-bold">料金</div>
            <div class="num-mont text-xl text-accent-deep">
              {formatPrice(category.starting_price)}〜
            </div>
          </div>
          <div class="bg-white rounded-xl px-4 py-3 border border-line-soft">
            <div class="text-[10px] text-muted font-bold">所要時間</div>
            <div class="num-mont text-xl text-navy">{category.duration}</div>
          </div>
          <div class="bg-white rounded-xl px-4 py-3 border border-line-soft">
            <div class="text-[10px] text-muted font-bold">保険</div>
            <div class="text-sm font-bold text-navy">損害保険完備</div>
          </div>
        </div>

        <div class="mt-8 flex flex-col sm:flex-row gap-3">
          <a
            href={`/contact?service=${category.slug}`}
            class="inline-flex justify-center items-center px-7 py-3.5 rounded-full bg-accent text-white font-bold shadow-orange hover:bg-accent-deep transition-colors"
          >
            📋 このサービスを申込む
          </a>
          <a
            href="tel:0592715908"
            class="inline-flex justify-center items-center gap-2 px-7 py-3.5 rounded-full bg-white border-2 border-navy text-navy font-bold"
          >
            📞 <span class="num-mont">059-271-5908</span>
          </a>
        </div>
      </div>

      <div class="hidden md:flex justify-center">
        <div class="w-80 h-80 rounded-full bg-white/60 backdrop-blur flex items-center justify-center text-[12rem]">
          {category.icon}
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-20 bg-white">
    <div class="max-w-5xl mx-auto px-4 md:px-8">
      <div class="text-center mb-10">
        <span class="label-en">PRICE LIST</span>
        <h2 class="text-2xl md:text-3xl font-black text-text mt-2">料金表</h2>
      </div>

      <div class="bg-bg-soft rounded-2xl border border-line-soft overflow-hidden">
        <table class="w-full text-sm">
          <thead class="bg-navy text-white">
            <tr>
              <th class="text-left px-5 py-3 font-bold">メニュー</th>
              <th class="text-right px-5 py-3 font-bold w-36">料金（税込）</th>
              <th class="text-right px-5 py-3 font-bold w-28 hidden sm:table-cell">所要時間</th>
            </tr>
          </thead>
          <tbody>
            {
              category.menus.filter((m) => m.published).map((m) => (
                <tr class="border-t border-line-soft bg-white">
                  <td class="px-5 py-4">
                    <div class="flex items-center gap-2 flex-wrap">
                      <span class="font-bold text-text">{m.name}</span>
                      {m.tag && (
                        <span class="text-[10px] bg-accent text-white px-2 py-0.5 rounded-full font-bold">
                          {m.tag}
                        </span>
                      )}
                    </div>
                    {m.description && (
                      <p class="text-xs text-muted mt-1">{m.description}</p>
                    )}
                  </td>
                  <td class="px-5 py-4 text-right num-mont text-lg text-accent-deep font-bold align-top">
                    {formatPrice(m.price, (m as any).price_label)}
                  </td>
                  <td class="px-5 py-4 text-right text-muted text-xs align-top hidden sm:table-cell">
                    {m.duration}
                  </td>
                </tr>
              ))
            }
            {
              category.options.length > 0 &&
                category.options.map((o) => (
                  <tr class="border-t border-line-soft bg-sky-mist">
                    <td class="px-5 py-4">
                      <div class="flex items-center gap-2">
                        <span class="text-xs bg-sky text-white px-2 py-0.5 rounded font-bold">
                          OPTION
                        </span>
                        <span class="font-bold text-text">{o.name}</span>
                      </div>
                      <p class="text-xs text-muted mt-1">{o.description}</p>
                    </td>
                    <td class="px-5 py-4 text-right num-mont text-accent font-bold align-top">
                      +¥{o.price.toLocaleString()}
                    </td>
                    <td class="px-5 py-4 text-right text-muted text-xs align-top hidden sm:table-cell">
                      {o.duration}
                    </td>
                  </tr>
                ))
            }
          </tbody>
        </table>
      </div>

      {
        category.notes.length > 0 && (
          <div class="mt-6 bg-sky-pale rounded-xl p-5 text-xs text-navy-deep space-y-1.5">
            {category.notes.map((n) => <p>※ {n}</p>)}
          </div>
        )
      }
      <div class="mt-3 text-xs text-text-soft space-y-1">
        {menusData.common_notes.map((n) => <p>※ {n}</p>)}
      </div>
    </div>
  </section>

  {
    category.flow.length > 0 && (
      <section class="py-16 md:py-20 bg-bg-soft">
        <div class="max-w-5xl mx-auto px-4 md:px-8">
          <div class="text-center mb-12">
            <span class="label-en">SERVICE FLOW</span>
            <h2 class="text-2xl md:text-3xl font-black text-text mt-2">
              施工の流れ
            </h2>
          </div>
          <ol class="space-y-4">
            {category.flow.map((f) => (
              <li class="bg-white rounded-2xl p-5 md:p-6 flex gap-5 items-start border border-line-soft">
                <div class="num-mont text-3xl md:text-4xl text-sky shrink-0">
                  {f.step}
                </div>
                <div class="flex-1">
                  <div class="flex items-center justify-between gap-3 flex-wrap">
                    <h3 class="font-black text-text text-lg">{f.title}</h3>
                    <span class="text-xs text-muted bg-sky-pale px-3 py-1 rounded-full">
                      ⏱ {f.duration}
                    </span>
                  </div>
                  <p class="mt-2 text-text-soft text-sm leading-relaxed">
                    {f.body}
                  </p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  }

  <section class="relative bg-gradient-to-br from-navy to-navy-deep text-white py-16 md:py-20 overflow-hidden">
    <div class="relative max-w-3xl mx-auto px-4 md:px-8 text-center">
      <h2 class="text-2xl md:text-4xl font-black leading-tight">
        {category.name}を申込む
      </h2>
      <p class="mt-5 text-sky-light">
        料金をその場でご確認いただけます。送信後、栗田より折り返しご連絡いたします。
      </p>
      <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
        <a
          href={`/contact?service=${category.slug}`}
          class="inline-flex justify-center items-center px-8 py-4 rounded-full bg-accent text-white font-bold shadow-orange hover:bg-accent-deep transition-colors"
        >
          📋 お申込み・見積もり
        </a>
        <a
          href="tel:0592715908"
          class="inline-flex justify-center items-center gap-2 px-8 py-4 rounded-full bg-white text-navy-deep font-bold"
        >
          📞 <span class="num-mont">059-271-5908</span>
        </a>
      </div>
    </div>
  </section>
</Layout>
