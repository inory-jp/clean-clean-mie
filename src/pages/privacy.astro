---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Icon from "../components/Icon.astro";
import site from "../data/site.json";

const sections = [
  {
    no: "01",
    title: "個人情報の取得項目",
    body: "当店は以下の個人情報を取得する場合があります。",
    list: [
      "お名前（漢字・フリガナ）",
      "ご住所（作業場所の住所を含む）",
      "電話番号、メールアドレス",
      "ご要望の内容（作業内容・対象機器・汚れの状況等）",
      "ご希望日時、駐車場の有無・場所等の作業環境に関する情報",
      "サイト閲覧時のCookie・アクセスログ・IPアドレス等",
    ],
  },
  {
    no: "02",
    title: "利用目的",
    body: "取得した個人情報は以下の目的で利用します。",
    list: [
      "お申込み内容の確認およびご連絡",
      "ハウスクリーニングサービスの提供",
      "お見積もり・お問い合わせへのご回答",
      "施工事例・サービス内容の改善および品質向上のための分析",
      "キャンペーンや営業に関するお知らせの送付",
      "契約事項に関する重要なご連絡",
      "法令に基づく必要な対応",
    ],
  },
  {
    no: "03",
    title: "第三者への提供",
    body: "ご本人の同意がある場合、または法令に基づき開示が求められた場合を除き、第三者へ提供することはありません。",
  },
  {
    no: "04",
    title: "個人情報の管理",
    body: "通信時はSSL暗号化を使用し、適切な安全管理措置を講じます。利用目的達成後は、速やかに削除または匿名化いたします。",
  },
  {
    no: "05",
    title: "Cookie・アクセス解析",
    body: "当サイトでは、利用状況の把握および改善のため Google Analytics（GA4）を利用しています。Cookieを利用することがありますが、個人を特定する情報は含まれません。Cookieの送信を希望されない場合は、ブラウザの設定で無効化、またはGoogleが提供するオプトアウト拡張機能をご利用ください。",
  },
  {
    no: "06",
    title: "開示・訂正・削除等のご請求",
    body: `お客様ご本人からの個人情報の開示・訂正・利用停止・削除のご請求につきましては、${site.email} までメールにてご連絡ください。`,
  },
  {
    no: "07",
    title: "本ポリシーの改定",
    body: "本プライバシーポリシーは、法令の改正やサービス内容の変更等に伴い、予告なく変更する場合があります。最新の内容は本ページに掲載いたします。",
  },
];
---

<Layout
  title="プライバシーポリシー｜CLEAN×CLEAN 津中央店"
  description="CLEAN×CLEAN 津中央店のプライバシーポリシー。個人情報の取扱い・取得項目・利用目的・第三者提供・Cookieの使用・開示請求窓口についてご案内します。"
>
  <PageHero
    label="PRIVACY POLICY"
    title="プライバシーポリシー"
    accent="ポリシー"
    lead={`${site.business_name}は、お客様の個人情報を以下の方針に基づき適切に取り扱います。`}
    breadcrumb={[{ label: "プライバシーポリシー", href: "/privacy" }]}
  />

  <section class="py-16 md:py-20 px-5 md:px-6 bg-white">
    <div class="grid lg:grid-cols-[240px_1fr] gap-8 max-w-5xl mx-auto">
      <aside class="hidden lg:block">
        <div class="sticky top-24 bg-bg-soft rounded-2xl p-5 border border-line-soft">
          <div class="text-[10px] text-muted font-bold tracking-widest mb-3">CONTENTS</div>
          <ol class="space-y-2 text-sm">
            {sections.map((s) => (
              <li>
                <a href={`#sec-${s.no}`} class="text-text-soft hover:text-navy flex items-start gap-2">
                  <span class="num-mont text-sky shrink-0 text-xs mt-1">{s.no}</span>
                  <span class="leading-snug">{s.title}</span>
                </a>
              </li>
            ))}
            <li>
              <a href="#sec-08" class="text-text-soft hover:text-navy flex items-start gap-2">
                <span class="num-mont text-sky shrink-0 text-xs mt-1">08</span>
                <span class="leading-snug">事業者情報</span>
              </a>
            </li>
          </ol>
        </div>
      </aside>

      <article class="bg-white">
        <div class="text-right text-xs text-muted mb-6">制定日: 2026年5月1日</div>
        <div class="space-y-9">
          {
            sections.map((s) => (
              <section id={`sec-${s.no}`} class="scroll-mt-24">
                <div class="flex items-start gap-4 mb-3">
                  <span
                    class="num-mont shrink-0 w-12 h-12 rounded-full flex items-center justify-center text-white text-sm"
                    style="background: linear-gradient(135deg, #78C8E0, #1E88B0);"
                  >
                    {s.no}
                  </span>
                  <h2 class="text-lg md:text-xl font-black text-navy leading-snug pt-2.5">
                    {s.title}
                  </h2>
                </div>
                <div class="pl-0 md:pl-16 text-text-soft text-sm leading-[1.95]">
                  <p>{s.body}</p>
                  {s.list && (
                    <ul class="mt-3 space-y-1.5">
                      {s.list.map((item) => (
                        <li class="flex items-start gap-2">
                          <Icon name="check" size={14} class="text-accent shrink-0 mt-1" />
                          <span>{item}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              </section>
            ))
          }

          <section id="sec-08" class="scroll-mt-24 bg-bg-soft rounded-2xl p-6 border border-line-soft">
            <div class="flex items-start gap-4 mb-3">
              <span
                class="num-mont shrink-0 w-12 h-12 rounded-full flex items-center justify-center text-white text-sm"
                style="background: linear-gradient(135deg, #FFB088, #FF7A45);"
              >
                08
              </span>
              <h2 class="text-lg md:text-xl font-black text-navy leading-snug pt-2.5">事業者情報</h2>
            </div>
            <dl class="pl-0 md:pl-16 text-sm text-text space-y-1.5">
              <div class="flex gap-3">
                <dt class="text-muted w-20 shrink-0">屋号</dt>
                <dd>{site.business_name}</dd>
              </div>
              <div class="flex gap-3">
                <dt class="text-muted w-20 shrink-0">代表者</dt>
                <dd>{site.representative}</dd>
              </div>
              <div class="flex gap-3">
                <dt class="text-muted w-20 shrink-0">所在地</dt>
                <dd>〒{site.postal_code} {site.address}</dd>
              </div>
              <div class="flex gap-3">
                <dt class="text-muted w-20 shrink-0">電話</dt>
                <dd>{site.tel}</dd>
              </div>
              <div class="flex gap-3">
                <dt class="text-muted w-20 shrink-0">メール</dt>
                <dd><a href={`mailto:${site.email}`} class="text-navy hover:underline">{site.email}</a></dd>
              </div>
            </dl>
          </section>
        </div>
      </article>
    </div>
  </section>
</Layout>
