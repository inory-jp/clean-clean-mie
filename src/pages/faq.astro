---
import Layout from "../layouts/Layout.astro";
import faqs from "../data/faqs.json";

const categories = ["すべて", ...Array.from(new Set(faqs.map((f) => f.category)))];
---

<Layout
  title="よくある質問｜CLEAN×CLEAN 津中央店"
  description="CLEAN×CLEAN 津中央店へよくいただくご質問と回答。料金・作業内容・お申込み・お支払いについて、事前に知っておきたいポイントをまとめています。"
>
  <section class="bg-gradient-to-b from-sky-mist to-white py-16 md:py-20">
    <div class="max-w-5xl mx-auto px-4 md:px-8 text-center">
      <span class="label-en">FAQ</span>
      <h1 class="text-3xl md:text-5xl font-black text-text mt-3">
        よくある<span class="text-navy">ご質問</span>
      </h1>
      <p class="mt-6 text-text-soft max-w-2xl mx-auto">
        ご検討いただく際によくいただくご質問にお答えします。<br />
        ここに無いご質問はお気軽にお電話またはフォームでお問い合わせください。
      </p>
    </div>
  </section>

  <section class="py-12 md:py-16 bg-white">
    <div class="max-w-3xl mx-auto px-4 md:px-8">
      <div class="flex flex-wrap gap-2 justify-center mb-10" id="faqFilters">
        {
          categories.map((c, i) => (
            <button
              type="button"
              class:list={[
                "faq-filter px-4 py-2 rounded-full text-sm font-bold border transition-colors",
                i === 0
                  ? "bg-navy text-white border-navy"
                  : "bg-white text-text-soft border-line hover:border-navy hover:text-navy",
              ]}
              data-category={c}
            >
              {c}
            </button>
          ))
        }
      </div>

      <div class="space-y-3" id="faqList">
        {
          faqs.map((f, i) => (
            <details
              class="faq-item bg-bg-soft rounded-2xl border border-line-soft overflow-hidden group"
              data-category={f.category}
            >
              <summary class="flex items-start gap-4 px-5 py-4 cursor-pointer list-none">
                <span class="num-mont text-navy text-sm shrink-0 mt-0.5">
                  Q{String(i + 1).padStart(2, "0")}
                </span>
                <span class="flex-1 font-bold text-text">{f.question}</span>
                <span class="text-xs bg-sky-pale text-navy px-2.5 py-1 rounded-full shrink-0 font-bold">
                  {f.category}
                </span>
                <span class="text-navy text-xl shrink-0 group-open:rotate-45 transition-transform">
                  ＋
                </span>
              </summary>
              <div class="px-5 pb-5 pt-0 pl-14 text-text-soft text-sm leading-relaxed">
                {f.answer}
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-bg-soft py-16">
    <div class="max-w-3xl mx-auto px-4 md:px-8 text-center">
      <h2 class="text-2xl md:text-3xl font-black text-text">
        他にご質問がある場合は
      </h2>
      <p class="mt-4 text-text-soft">
        お気軽にお電話またはフォームでお問い合わせください。
      </p>
      <div class="mt-8 flex flex-col sm:flex-row gap-3 justify-center">
        <a
          href="/contact"
          class="inline-flex justify-center items-center px-7 py-3.5 rounded-full bg-accent text-white font-bold shadow-orange hover:bg-accent-deep transition-colors"
        >
          📋 お申込み・見積もり
        </a>
        <a
          href="tel:0592715908"
          class="inline-flex justify-center items-center gap-2 px-7 py-3.5 rounded-full bg-white border-2 border-navy text-navy font-bold"
        >
          📞 <span class="num-mont">059-271-5908</span>
        </a>
      </div>
    </div>
  </section>
</Layout>

<script>
  const filters = document.querySelectorAll<HTMLButtonElement>(".faq-filter");
  const items = document.querySelectorAll<HTMLDetailsElement>(".faq-item");

  filters.forEach((btn) => {
    btn.addEventListener("click", () => {
      const cat = btn.dataset.category;

      filters.forEach((b) => {
        b.classList.remove("bg-navy", "text-white", "border-navy");
        b.classList.add("bg-white", "text-text-soft", "border-line");
      });
      btn.classList.add("bg-navy", "text-white", "border-navy");
      btn.classList.remove("bg-white", "text-text-soft", "border-line");

      items.forEach((item) => {
        const show = cat === "すべて" || item.dataset.category === cat;
        item.style.display = show ? "" : "none";
      });
    });
  });
</script>
