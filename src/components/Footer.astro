---
import Icon from "./Icon.astro";

const tel = "059-271-5908";
const telHref = "tel:0592715908";
const services = [
  { href: "/service/aircon", label: "エアコンクリーニング" },
  { href: "/service/bath", label: "お風呂クリーニング" },
  { href: "/service/kitchen", label: "キッチン・換気扇クリーニング" },
  { href: "/service/other", label: "その他クリーニング" },
];
const info = [
  { href: "/about", label: "会社概要・店主紹介" },
  { href: "/news", label: "お知らせ・ブログ" },
  { href: "/faq", label: "よくある質問" },
  { href: "/privacy", label: "プライバシーポリシー" },
];
const year = new Date().getFullYear();

const infoItems = [
  { icon: "phone", label: "TEL", value: tel, href: telHref },
  { icon: "clock", label: "営業時間", value: "9:00〜18:00 / 不定休" },
  { icon: "pin", label: "所在地", value: "三重県津市上浜町3-15-2" },
  { icon: "shield", label: "保険", value: "損害賠償保険加入済" },
];
---

<footer class="bg-navy-deep text-white">
  <div class="bg-navy">
    <div class="max-w-7xl mx-auto px-4 md:px-8 py-4 grid grid-cols-2 lg:grid-cols-4 gap-3 text-sm">
      {
        infoItems.map((it) => (
          <div class="flex items-start gap-2.5">
            <div
              class="w-8 h-8 rounded-lg flex items-center justify-center shrink-0 text-white"
              style="background: linear-gradient(135deg, #78C8E0, #4FB0CE);"
            >
              <Icon name={it.icon} size={16} />
            </div>
            <div>
              <div class="text-[10px] text-sky-light tracking-wider font-bold">{it.label}</div>
              {it.href ? (
                <a href={it.href} class="num-mont text-sm hover:text-gold">{it.value}</a>
              ) : (
                <div class="text-xs">{it.value}</div>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 md:px-8 py-12 grid lg:grid-cols-4 gap-10">
    <div class="lg:col-span-2">
      <a href="/" class="inline-block">
        <img src="/assets/footer-logo.jpg" alt="CLEAN×CLEAN" class="h-16 md:h-20 w-auto rounded-lg" />
      </a>
      <div class="mt-4 text-gold font-bold tracking-wider">ありがとうの輪を、地域へ。</div>
      <p class="mt-3 text-sky-light text-sm leading-relaxed max-w-md">
        <strong class="text-white">CLEAN×CLEAN 津中央店</strong><br />
        三重県津市・松阪市・鈴鹿市を中心に活動するハウスクリーニング店。下請けに出さず、店主が直接施工。損害保険完備で安心の作業をお届けします。
      </p>
    </div>

    <div>
      <div class="text-gold font-bold mb-4">サービス</div>
      <ul class="space-y-2 text-sm text-sky-light">
        {services.map((s) => <li><a href={s.href} class="hover:text-white">{s.label}</a></li>)}
      </ul>
    </div>

    <div>
      <div class="text-gold font-bold mb-4">情報</div>
      <ul class="space-y-2 text-sm text-sky-light">
        {info.map((s) => <li><a href={s.href} class="hover:text-white">{s.label}</a></li>)}
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="max-w-7xl mx-auto px-4 md:px-8 py-4 text-xs text-sky-light text-center">
      © {year} CLEAN×CLEAN 津中央店 All Rights Reserved.
    </div>
  </div>
</footer>
