---
import Icon from "../Icon.astro";
import faqs from "../../data/faqs.json";

const featured = faqs.slice(0, 6);

const cats = [
  { id: "", label: "すべて", icon: "clipboard" },
  { id: "料金", label: "料金", icon: "money" },
  { id: "作業", label: "作業", icon: "tools" },
  { id: "お申込み", label: "お申込み", icon: "document" },
  { id: "支払い", label: "お支払い", icon: "card" },
];
---

<section class="py-16 md:py-24 px-5 md:px-6 bg-white">
  <div class="max-w-[1240px] mx-auto">
    <div class="text-center mb-10">
      <span class="label-en">FAQ</span>
      <h2 class="section-h2 mt-2">
        よくある<span class="accent">ご質問</span>
      </h2>
      <p class="text-muted mt-4 text-sm">
        ご検討時によくいただくご質問にお答えします
      </p>
    </div>

    <div class="faq-cats max-w-3xl mx-auto">
      {
        cats.map((c, i) => (
          <button
            type="button"
            class={`faq-cat ${i === 0 ? "active" : ""}`}
            data-category={c.id}
          >
            <Icon name={c.icon} size={14} />
            {c.label}
          </button>
        ))
      }
    </div>

    <div class="faq-grid grid md:grid-cols-2 gap-4 max-w-5xl mx-auto items-start">
      <div class="space-y-3 md:space-y-4">
        {featured.filter((_, i) => i % 2 === 0).map((f, idx) => {
          const i = idx * 2;
          return (
            <details class="faq-item" data-category={f.category} open={i === 0}>
              <summary class="faq-q-row">
                <div class="faq-q-mark">Q</div>
                <div class="faq-q-text">{f.question}</div>
                <div class="faq-q-arrow">▼</div>
              </summary>
              <div class="faq-a-content">
                <div class="faq-a-mark">A</div>
                <div class="faq-a-text">{f.answer}</div>
              </div>
            </details>
          );
        })}
      </div>
      <div class="space-y-3 md:space-y-4">
        {featured.filter((_, i) => i % 2 === 1).map((f) => (
          <details class="faq-item" data-category={f.category}>
            <summary class="faq-q-row">
              <div class="faq-q-mark">Q</div>
              <div class="faq-q-text">{f.question}</div>
              <div class="faq-q-arrow">▼</div>
            </summary>
            <div class="faq-a-content">
              <div class="faq-a-mark">A</div>
              <div class="faq-a-text">{f.answer}</div>
            </div>
          </details>
        ))}
      </div>
    </div>

    <div class="faq-bottom">
      <div>
        <h4>解決しないお困りごとはありませんか？</h4>
        <p>こちらに掲載していないご質問・ご相談もお気軽にお問い合わせください。</p>
      </div>
      <a href="/faq" class="btn">
        <Icon name="clipboard" size={16} /> すべてのFAQを見る →
      </a>
    </div>
  </div>
</section>

<style>
  .faq-cats {
    display: flex;
    gap: 6px;
    justify-content: center;
    margin-bottom: 28px;
    flex-wrap: wrap;
  }
  @media (min-width: 768px) {
    .faq-cats { gap: 10px; margin-bottom: 32px; }
  }
  .faq-cat {
    padding: 8px 14px;
    border: 2px solid #E1E8F0;
    border-radius: 999px;
    background: #FFF;
    cursor: pointer;
    font-size: 12px;
    font-weight: 700;
    color: #6B7A8F;
    transition: all 0.25s;
    font-family: inherit;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  @media (min-width: 768px) {
    .faq-cat {
      padding: 10px 22px;
      font-size: 13px;
      gap: 8px;
    }
  }
  .faq-cat:hover {
    border-color: #78C8E0;
    color: #1E88B0;
  }
  .faq-cat.active {
    background: #1E88B0;
    color: #FFF;
    border-color: #1E88B0;
  }

  .faq-item {
    background: #FFF;
    border: 1px solid #E1E8F0;
    border-radius: 16px;
    transition: border-color 0.2s, box-shadow 0.2s;
    overflow: hidden;
  }
  .faq-item:hover {
    border-color: #78C8E0;
  }
  .faq-item[open] {
    border-color: #1E88B0;
    box-shadow: 0 4px 12px rgba(30, 136, 176, 0.08);
  }
  .faq-q-row {
    padding: 18px 20px;
    cursor: pointer;
    display: flex;
    gap: 12px;
    align-items: flex-start;
    user-select: none;
    list-style: none;
  }
  .faq-q-row::-webkit-details-marker {
    display: none;
  }
  .faq-q-mark {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    background: #1E88B0;
    color: #FFF;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-family: "Montserrat", sans-serif;
    font-weight: 900;
  }
  .faq-q-text {
    flex: 1;
    font-weight: 700;
    color: #1E88B0;
    font-size: 14px;
    line-height: 1.55;
    padding-top: 4px;
  }
  .faq-q-arrow {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #F7FAFC;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #6B7A8F;
    font-size: 10px;
    transition: transform 0.3s, background 0.3s, color 0.3s;
  }
  .faq-item[open] .faq-q-arrow {
    background: #FF7A45;
    color: #FFF;
    transform: rotate(180deg);
  }
  .faq-a-content {
    display: flex;
    gap: 12px;
    padding: 0 20px 18px 20px;
    align-items: flex-start;
  }
  .faq-a-mark {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    background: #FF7A45;
    color: #FFF;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-family: "Montserrat", sans-serif;
    font-weight: 900;
  }
  .faq-a-text {
    flex: 1;
    color: #3F4E63;
    font-size: 13px;
    line-height: 1.85;
  }

  .faq-bottom {
    max-width: 900px;
    margin: 40px auto 0;
    padding: 28px 32px;
    background: linear-gradient(135deg, #1E88B0, #4FB0CE);
    color: #FFF;
    border-radius: 24px;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 24px;
    box-shadow: 0 12px 36px rgba(30, 136, 176, 0.18);
  }
  @media (max-width: 768px) {
    .faq-bottom {
      grid-template-columns: 1fr;
      padding: 24px 20px;
      text-align: center;
    }
  }
  .faq-bottom h4 {
    font-size: 17px;
    margin-bottom: 4px;
    font-weight: 700;
  }
  .faq-bottom p {
    opacity: 0.92;
    font-size: 13px;
  }
  .faq-bottom .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    background: #FFF;
    color: #1E88B0;
    padding: 13px 24px;
    border-radius: 999px;
    font-weight: 700;
    font-size: 13px;
    transition: all 0.25s;
    white-space: nowrap;
  }
  .faq-bottom .btn:hover {
    background: #FFEB3B;
  }
</style>

<script>
  const cats = document.querySelectorAll<HTMLButtonElement>(".faq-cat");
  const items = document.querySelectorAll<HTMLElement>(".faq-item");

  cats.forEach((btn) => {
    btn.addEventListener("click", () => {
      cats.forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      const cat = btn.dataset.category || "";
      items.forEach((it) => {
        const show = !cat || it.dataset.category === cat;
        it.style.display = show ? "" : "none";
      });
    });
  });
</script>
