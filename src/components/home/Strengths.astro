---
const items = [
  {
    no: "01",
    title: "店主が直接施工",
    body: "下請けに出さず、店主である栗田が全工程を責任を持って担当。お一人おひとりに顔の見える安心施工をお届けします。",
    tag: "✓ 一貫責任体制",
    icon: "👨‍🔧",
  },
  {
    no: "02",
    title: "損害保険完備",
    body: "万一の事故にも備え、損害賠償保険に加入済み。大切なご自宅を守る体制を整えていますので安心してお任せください。",
    tag: "✓ 補償体制完備",
    icon: "🛡️",
  },
  {
    no: "03",
    title: "三重県全域対応",
    body: "津・松阪・鈴鹿を中心に三重県全域へ。地域密着で、迅速な対応が可能です。エリア外もまずはご相談ください。",
    tag: "✓ 地域密着",
    icon: "📍",
  },
];
---

<section id="strengths" class="bg-bg-soft py-24 md:py-32 px-6">
  <div class="max-w-[1240px] mx-auto">
    <div class="text-center mb-16">
      <span class="label-en">OUR STRENGTHS</span>
      <h2 class="section-h2 mt-2">
        選ばれる<span class="accent">3つの理由</span>
      </h2>
      <p class="text-muted mt-4 text-base leading-relaxed">
        地域に根ざした、店主直接施工のハウスクリーニング。<br class="hidden sm:inline" />
        顔の見える安心と、確かな品質をお届けします。
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-7">
      {
        items.map((it) => (
          <div class="strength-card relative bg-white rounded-[28px] px-9 pt-12 pb-10 text-left shadow-sm overflow-hidden transition-all duration-500 hover:-translate-y-2 hover:shadow-xl">
            <span
              aria-hidden="true"
              class="absolute top-0 left-0 right-0 h-1 origin-left scale-x-0 transition-transform duration-500 group-hover:scale-x-100"
              style="background: linear-gradient(90deg, #78C8E0, #1E88B0); transform: scaleX(0); transform-origin: left;"
            />
            <div
              class="num-mont absolute top-6 right-7 text-[72px] leading-none text-sky-pale pointer-events-none"
              style="letter-spacing: -0.04em;"
            >
              {it.no}
            </div>
            <div
              class="w-[72px] h-[72px] mb-6 rounded-[18px] flex items-center justify-center text-3xl"
              style="background: linear-gradient(135deg, #E8F5F9, #9CD8E8); box-shadow: 0 6px 20px rgba(120,200,224,0.30);"
            >
              {it.icon}
            </div>
            <h3 class="text-navy mb-3 text-[22px] font-extrabold leading-snug">
              {it.title}
            </h3>
            <p class="text-text-soft text-sm leading-[1.9]">{it.body}</p>
            <div class="mt-5 inline-block px-3 py-1 bg-sky-pale text-navy text-[11px] font-bold rounded-full">
              {it.tag}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .strength-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, #78C8E0, #1E88B0);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .strength-card:hover::before {
    transform: scaleX(1);
  }
</style>
