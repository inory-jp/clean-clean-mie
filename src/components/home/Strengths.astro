---
const items = [
  {
    no: "01",
    title: "店主が直接施工",
    body: "下請けに出さず、店主である栗田が全工程を責任を持って担当。お一人おひとりに顔の見える安心施工をお届けします。",
    tag: "✓ 一貫責任体制",
    svg: '<path d="M12 2L4 6v6c0 5.5 3.8 10.7 8 12 4.2-1.3 8-6.5 8-12V6l-8-4zm0 6.5c1.4 0 2.5 1.1 2.5 2.5S13.4 13.5 12 13.5 9.5 12.4 9.5 11s1.1-2.5 2.5-2.5zm0 12c-2 0-3.7-.6-5.1-1.6.1-1.7 3.4-2.6 5.1-2.6 1.7 0 5 .9 5.1 2.6-1.4 1-3.1 1.6-5.1 1.6z"/>',
  },
  {
    no: "02",
    title: "損害保険完備",
    body: "万一の事故にも備え、損害賠償保険に加入済み。大切なご自宅を守る体制を整えていますので安心してお任せください。",
    tag: "✓ 補償体制完備",
    svg: '<path d="M12 1L3 5v6c0 5.5 3.8 10.7 9 12 5.2-1.3 9-6.5 9-12V5l-9-4zm-2 16l-4-4 1.4-1.4L10 14.2l6.6-6.6L18 9l-8 8z"/>',
  },
  {
    no: "03",
    title: "三重県全域対応",
    body: "津・松阪・鈴鹿を中心に三重県全域へ。地域密着で、迅速な対応が可能です。エリア外もまずはご相談ください。",
    tag: "✓ 地域密着",
    svg: '<path d="M12 2C8.1 2 5 5.1 5 9c0 5.3 7 13 7 13s7-7.7 7-13c0-3.9-3.1-7-7-7zm0 9.5c-1.4 0-2.5-1.1-2.5-2.5s1.1-2.5 2.5-2.5 2.5 1.1 2.5 2.5-1.1 2.5-2.5 2.5z"/>',
  },
];
---

<section id="strengths" class="bg-bg-soft py-16 md:py-32 px-5 md:px-6">
  <div class="max-w-[1240px] mx-auto">
    <div class="text-center mb-16">
      <span class="label-en">OUR STRENGTHS</span>
      <h2 class="section-h2 mt-2">
        選ばれる<span class="accent">3つの理由</span>
      </h2>
      <p class="text-muted mt-4 text-base leading-relaxed">
        地域に根ざした、店主直接施工のハウスクリーニング。<br class="hidden sm:inline" />
        顔の見える安心と、確かな品質をお届けします。
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-7">
      {
        items.map((it) => (
          <div class="strength-card relative bg-white rounded-[24px] md:rounded-[28px] px-7 md:px-9 pt-10 md:pt-12 pb-8 md:pb-10 text-left shadow-sm overflow-hidden transition-all duration-500 hover:-translate-y-2 hover:shadow-xl">
            <div
              class="num-mont absolute top-5 md:top-6 right-5 md:right-7 text-[56px] md:text-[76px] leading-none text-sky-pale pointer-events-none transition-colors duration-300"
              style="letter-spacing: -0.04em; font-weight: 700;"
            >
              {it.no}
            </div>
            <div
              class="w-[72px] h-[72px] mb-6 rounded-[18px] flex items-center justify-center"
              style="background: linear-gradient(135deg, #E8F5F9, #9CD8E8); box-shadow: 0 6px 20px rgba(120,200,224,0.30);"
            >
              <svg viewBox="0 0 24 24" class="w-9 h-9" fill="white" set:html={it.svg} />
            </div>
            <h3 class="text-navy mb-3.5 text-[22px] font-extrabold leading-snug">
              {it.title}
            </h3>
            <p class="text-text-soft text-sm leading-[1.9]">{it.body}</p>
            <div class="mt-4 inline-block px-3 py-1 bg-sky-pale text-navy text-[11px] font-bold rounded-full">
              {it.tag}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .strength-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, #78c8e0, #1e88b0);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .strength-card:hover::before {
    transform: scaleX(1);
  }
  .strength-card:hover .num-mont {
    color: #c2e5ef !important;
  }
</style>
