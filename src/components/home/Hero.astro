---
import Icon from "../Icon.astro";
import { getActiveCampaigns } from "../../lib/microcms";

const campaigns = await getActiveCampaigns();
const hasCampaigns = campaigns.length > 0;
---

<section class="hero relative overflow-hidden" style="background: linear-gradient(180deg, #FFF 0%, #F5FBFD 60%, #E8F5F9 100%); padding: 32px 0 64px;">
  <div class="hero-blob hero-blob-1" aria-hidden="true"></div>
  <div class="hero-blob hero-blob-2" aria-hidden="true"></div>
  <div class="hero-bubble b1" aria-hidden="true"></div>
  <div class="hero-bubble b2" aria-hidden="true"></div>
  <div class="hero-bubble b3" aria-hidden="true"></div>

  {
    hasCampaigns ? (
      <div class="relative z-[1]" id="heroSlider">
        <div class="slider-viewport overflow-hidden">
          <div class="slides-track" id="slidesTrack">
            {campaigns.map((c, i) => {
              const inner = (
                <picture>
                  {c.banner_image_sp && (
                    <source
                      media="(max-width: 767px)"
                      srcset={`${c.banner_image_sp.url}?w=750&fm=webp&q=85`}
                    />
                  )}
                  <img
                    src={`${c.banner_image_pc.url}?w=1920&fm=webp&q=85`}
                    alt={c.alt_text}
                    width={c.banner_image_pc.width}
                    height={c.banner_image_pc.height}
                    class="w-full h-full object-cover"
                    loading={i === 0 ? "eager" : "lazy"}
                  />
                </picture>
              );
              return (
                <div
                  class={`slide ${i === 0 ? "active" : ""}`}
                  data-index={i}
                  data-notice-text={c.notice_text || ""}
                  data-notice-link={c.link_url || ""}
                >
                  {c.link_url ? <a href={c.link_url} class="block w-full h-full">{inner}</a> : inner}
                </div>
              );
            })}
          </div>
        </div>

        {campaigns.length > 1 && (
          <>
            <button type="button" id="prevBtn" class="slider-arrow prev" aria-label="前へ">‹</button>
            <button type="button" id="nextBtn" class="slider-arrow next" aria-label="次へ">›</button>
            <div class="flex gap-2 justify-center mt-7">
              {campaigns.map((_, i) => (
                <button
                  type="button"
                  class={`hero-dot ${i === 0 ? "active" : ""}`}
                  data-index={i}
                  aria-label={`スライド ${i + 1}`}
                />
              ))}
            </div>
          </>
        )}

        <div class="flex gap-4 justify-center flex-wrap mt-9">
          <a href="/contact" class="btn-cta btn-large">
            <Icon name="clipboard" size={18} /> お申込み・見積もり
          </a>
          <a href="tel:0592715908" class="btn-tel btn-large">
            <Icon name="phone" size={18} /> <span class="num-mont">059-271-5908</span>
          </a>
        </div>
        <div class="mt-5 text-center text-xs text-muted">
          対応エリア: 津・松阪・鈴鹿ほか三重県全域 ／ 損害保険完備 ／ 翌営業日中に一次返信
        </div>
      </div>
    ) : (
      <div class="relative max-w-[1240px] mx-auto px-4 md:px-8 py-12 md:py-20 grid md:grid-cols-2 gap-8 items-center z-[1]">
        <div>
          <span class="label-en">HOUSE CLEANING IN MIE</span>
          <h1 class="mt-4 text-4xl md:text-6xl font-black leading-[1.18] text-text" style="letter-spacing: -0.02em;">
            ありがとうの輪を、地域へ。<br />
            <span class="text-navy">三重のハウスクリーニング</span>
          </h1>
          <p class="mt-6 text-text-soft leading-[1.9]">
            津市・松阪市・鈴鹿市を中心に、店主が直接施工。<br class="hidden md:inline" />
            損害保険完備で、安心して任せられるクリーニングをお届けします。
          </p>
          <div class="mt-9 flex flex-col sm:flex-row gap-4">
            <a href="/contact" class="btn-cta btn-large">
              📋 お申込み・見積もり
            </a>
            <a href="tel:0592715908" class="btn-tel btn-large">
              📞 <span class="num-mont">059-271-5908</span>
            </a>
          </div>
        </div>
        <div class="hidden md:flex justify-center">
          <div class="w-80 h-80 rounded-full flex items-center justify-center text-navy" style="background: linear-gradient(135deg, #E8F5F9, #C2E5EF); box-shadow: 0 24px 80px rgba(30,136,176,0.18);">
            <Icon name="sparkle" size={140} />
          </div>
        </div>
      </div>
    )
  }
</section>

<style>
  .hero-blob {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }
  .hero-blob-1 {
    width: 580px;
    height: 580px;
    background: radial-gradient(circle, rgba(120, 200, 224, 0.30) 0%, transparent 70%);
    top: -260px;
    left: -200px;
  }
  .hero-blob-2 {
    width: 700px;
    height: 700px;
    background: radial-gradient(circle, rgba(194, 229, 239, 0.40) 0%, transparent 70%);
    bottom: -380px;
    right: -200px;
  }
  .slides-track {
    display: flex;
    gap: 24px;
    padding: 0 8vw;
    transition: transform 0.7s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .slide {
    flex: 0 0 84vw;
    aspect-ratio: 16 / 7;
    border-radius: 28px;
    box-shadow: 0 24px 80px rgba(30, 136, 176, 0.18);
    overflow: hidden;
    position: relative;
    transform: scale(0.95);
    opacity: 0.55;
    transition: transform 0.6s cubic-bezier(0.22, 0.61, 0.36, 1), opacity 0.6s;
    background: #f5fbfd;
  }
  .slide.active {
    transform: scale(1);
    opacity: 1;
  }
  .slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .slider-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: #FFF;
    border: none;
    cursor: pointer;
    box-shadow: 0 8px 24px rgba(30, 136, 176, 0.10);
    color: #1E88B0;
    font-size: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 3;
    transition: all 0.3s;
    line-height: 1;
    padding-bottom: 3px;
  }
  .slider-arrow:hover {
    background: #1E88B0;
    color: #FFF;
    transform: translateY(-50%) scale(1.05);
  }
  .slider-arrow.prev { left: 32px; }
  .slider-arrow.next { right: 32px; }
  @media (max-width: 768px) {
    .slider-arrow { display: none; }
    .slides-track { padding: 0 6vw; gap: 16px; }
    .slide { flex: 0 0 88vw; }
  }

  .hero-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #E1E8F0;
    border: none;
    cursor: pointer;
    padding: 0;
    transition: all 0.3s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .hero-dot:hover {
    background: #78c8e0;
  }
  .hero-dot.active {
    background: #1E88B0;
    width: 36px;
    border-radius: 999px;
  }
</style>

<script>
  const track = document.getElementById("slidesTrack");
  const realSlides = Array.from(document.querySelectorAll<HTMLElement>(".slide"));
  const dots = document.querySelectorAll<HTMLElement>(".hero-dot");
  const prevBtn = document.getElementById("prevBtn");
  const nextBtn = document.getElementById("nextBtn");
  const noticeBar = document.getElementById("noticeBar");
  const noticeText = document.getElementById("noticeText");
  const noticeLink = document.getElementById("noticeLink") as HTMLAnchorElement | null;
  const total = realSlides.length;
  let cur = 0; // logical index 0..total-1
  let pos = total > 1 ? 1 : 0; // physical index in track (with clones)
  let animating = false;
  let timer: ReturnType<typeof setInterval> | null = null;
  const transition = "transform 0.7s cubic-bezier(0.22, 0.61, 0.36, 1)";

  // Insert clones for infinite loop
  if (track && total > 1) {
    const firstClone = realSlides[0].cloneNode(true) as HTMLElement;
    const lastClone = realSlides[total - 1].cloneNode(true) as HTMLElement;
    firstClone.classList.remove("active");
    lastClone.classList.remove("active");
    firstClone.dataset.clone = "1";
    lastClone.dataset.clone = "1";
    track.appendChild(firstClone);
    track.insertBefore(lastClone, track.firstChild);
  }

  const allSlides = track ? Array.from(track.querySelectorAll<HTMLElement>(".slide")) : [];

  function getSlideWidth() {
    return window.innerWidth * 0.84 + 24;
  }

  function applyPos(animate = true) {
    if (!track) return;
    track.style.transition = animate ? transition : "none";
    track.style.transform = `translateX(${-pos * getSlideWidth()}px)`;
  }

  function setActive() {
    allSlides.forEach((s, i) => s.classList.toggle("active", i === pos));
    dots.forEach((d, idx) => d.classList.toggle("active", idx === cur));
    if (realSlides[cur]) syncNotice(realSlides[cur]);
  }

  function syncNotice(slide: HTMLElement) {
    if (!noticeBar || !noticeText) return;
    const text = slide.dataset.noticeText || "";
    const link = slide.dataset.noticeLink || "";
    if (text.trim().length === 0) {
      noticeBar.style.display = "none";
      return;
    }
    noticeBar.style.display = "";
    noticeText.textContent = text;
    if (noticeLink) {
      if (link) {
        noticeLink.setAttribute("href", link);
        noticeLink.style.pointerEvents = "auto";
        noticeLink.style.textDecoration = "underline";
      } else {
        noticeLink.removeAttribute("href");
        noticeLink.style.pointerEvents = "none";
        noticeLink.style.textDecoration = "none";
      }
    }
  }

  function next() {
    if (animating || total <= 1) return;
    animating = true;
    pos++;
    cur = (cur + 1) % total;
    applyPos(true);
    setActive();
  }

  function prev() {
    if (animating || total <= 1) return;
    animating = true;
    pos--;
    cur = (cur - 1 + total) % total;
    applyPos(true);
    setActive();
  }

  function jumpTo(i: number) {
    if (animating || total <= 1) return;
    animating = true;
    cur = i;
    pos = i + 1;
    applyPos(true);
    setActive();
  }

  if (track) {
    track.addEventListener("transitionend", () => {
      animating = false;
      // If we slid onto a clone, snap to the real slide without animation
      if (pos === 0) {
        pos = total;
        applyPos(false);
      } else if (pos === total + 1) {
        pos = 1;
        applyPos(false);
      }
    });
  }

  function startTimer() {
    if (total <= 1) return;
    if (timer) clearInterval(timer);
    timer = setInterval(next, 6000);
  }

  dots.forEach((d, i) => d.addEventListener("click", () => { jumpTo(i); startTimer(); }));
  prevBtn?.addEventListener("click", () => { prev(); startTimer(); });
  nextBtn?.addEventListener("click", () => { next(); startTimer(); });
  window.addEventListener("resize", () => applyPos(false));

  // initial
  applyPos(false);
  setActive();
  startTimer();
</script>
