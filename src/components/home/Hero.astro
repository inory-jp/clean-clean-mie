---
import { getActiveCampaigns } from "../../lib/microcms";

const campaigns = await getActiveCampaigns();
const hasCampaigns = campaigns.length > 0;
---

{
  hasCampaigns ? (
    <section class="relative overflow-hidden bg-sky-mist">
      <div class="relative" id="heroSlider">
        {campaigns.map((c, i) => {
          const inner = (
            <picture>
              {c.banner_image_sp && (
                <source
                  media="(max-width: 767px)"
                  srcset={`${c.banner_image_sp.url}?w=750&fm=webp&q=85`}
                />
              )}
              <img
                src={`${c.banner_image_pc.url}?w=1920&fm=webp&q=85`}
                alt={c.alt_text}
                width={c.banner_image_pc.width}
                height={c.banner_image_pc.height}
                class="w-full h-auto block"
                loading={i === 0 ? "eager" : "lazy"}
              />
            </picture>
          );
          return (
            <div
              class={`hero-slide ${i === 0 ? "active" : ""} transition-opacity duration-700`}
              data-index={i}
            >
              {c.link_url ? <a href={c.link_url}>{inner}</a> : inner}
            </div>
          );
        })}
      </div>

      {campaigns.length > 1 && (
        <div class="absolute bottom-4 md:bottom-6 left-1/2 -translate-x-1/2 flex gap-2 z-10">
          {campaigns.map((_, i) => (
            <button
              type="button"
              class={`hero-dot w-2.5 h-2.5 rounded-full transition-all ${i === 0 ? "bg-navy w-8" : "bg-white shadow"}`}
              data-index={i}
              aria-label={`スライド ${i + 1}`}
            />
          ))}
        </div>
      )}

      <div class="bg-white py-6 md:py-8 border-t border-line-soft">
        <div class="max-w-5xl mx-auto px-4 md:px-8 flex flex-col sm:flex-row gap-3 justify-center">
          <a
            href="/contact"
            class="inline-flex justify-center items-center px-7 py-3.5 rounded-full bg-accent text-white font-bold shadow-orange hover:bg-accent-deep transition-colors"
          >
            📋 お申込み・見積もり
          </a>
          <a
            href="tel:0592715908"
            class="inline-flex justify-center items-center gap-2 px-7 py-3.5 rounded-full bg-white border-2 border-navy text-navy font-bold"
          >
            📞 <span class="num-mont">059-271-5908</span>
          </a>
        </div>
      </div>
    </section>
  ) : (
    <section class="relative overflow-hidden bg-gradient-to-br from-sky-mist via-sky-pale to-sky-mist">
      <div class="max-w-7xl mx-auto px-4 md:px-8 py-16 md:py-28 grid md:grid-cols-2 gap-8 items-center">
        <div>
          <span class="label-en">HOUSE CLEANING IN MIE</span>
          <h1 class="mt-4 text-3xl md:text-5xl font-black leading-tight text-text">
            ありがとうの輪を、地域へ。<br />
            <span class="text-navy">三重のハウスクリーニング</span>
          </h1>
          <p class="mt-5 text-text-soft leading-relaxed">
            津市・松阪市・鈴鹿市を中心に、店主が直接施工。<br class="hidden md:inline" />
            損害保険完備で、安心して任せられるクリーニングをお届けします。
          </p>
          <div class="mt-8 flex flex-col sm:flex-row gap-3">
            <a
              href="/contact"
              class="inline-flex justify-center items-center px-7 py-3.5 rounded-full bg-accent text-white font-bold shadow-orange hover:bg-accent-deep transition-colors"
            >
              📋 お申込み・見積もり
            </a>
            <a
              href="tel:0592715908"
              class="inline-flex justify-center items-center gap-2 px-7 py-3.5 rounded-full bg-white border-2 border-navy text-navy font-bold"
            >
              📞 <span class="num-mont">059-271-5908</span>
            </a>
          </div>
        </div>
        <div class="hidden md:flex justify-center">
          <div class="w-80 h-80 rounded-full bg-white/60 backdrop-blur flex items-center justify-center text-[12rem]">
            🧽
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  .hero-slide {
    display: none;
  }
  .hero-slide.active {
    display: block;
  }
</style>

<script>
  const slides = document.querySelectorAll<HTMLElement>(".hero-slide");
  const dots = document.querySelectorAll<HTMLElement>(".hero-dot");
  let cur = 0;

  function show(i: number) {
    slides.forEach((s, idx) => s.classList.toggle("active", idx === i));
    dots.forEach((d, idx) => {
      d.classList.toggle("bg-navy", idx === i);
      d.classList.toggle("w-8", idx === i);
      d.classList.toggle("bg-white", idx !== i);
    });
    cur = i;
  }

  dots.forEach((d, i) => d.addEventListener("click", () => show(i)));

  if (slides.length > 1) {
    setInterval(() => show((cur + 1) % slides.length), 6000);
  }
</script>
