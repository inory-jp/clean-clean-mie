---
import { getActiveCampaigns } from "../../lib/microcms";

const campaigns = await getActiveCampaigns();
const hasCampaigns = campaigns.length > 0;
---

<section class="hero relative overflow-hidden" style="background: linear-gradient(180deg, #FFF 0%, #F5FBFD 60%, #E8F5F9 100%); padding: 32px 0 64px;">
  <div class="hero-blob hero-blob-1" aria-hidden="true"></div>
  <div class="hero-blob hero-blob-2" aria-hidden="true"></div>
  <div class="hero-bubble b1" aria-hidden="true"></div>
  <div class="hero-bubble b2" aria-hidden="true"></div>
  <div class="hero-bubble b3" aria-hidden="true"></div>

  {
    hasCampaigns ? (
      <div class="relative z-[1]" id="heroSlider">
        <div class="slider-viewport overflow-hidden">
          <div class="slides-track" id="slidesTrack">
            {campaigns.map((c, i) => {
              const inner = (
                <picture>
                  {c.banner_image_sp && (
                    <source
                      media="(max-width: 767px)"
                      srcset={`${c.banner_image_sp.url}?w=750&fm=webp&q=85`}
                    />
                  )}
                  <img
                    src={`${c.banner_image_pc.url}?w=1920&fm=webp&q=85`}
                    alt={c.alt_text}
                    width={c.banner_image_pc.width}
                    height={c.banner_image_pc.height}
                    class="w-full h-full object-cover"
                    loading={i === 0 ? "eager" : "lazy"}
                  />
                </picture>
              );
              return (
                <div
                  class={`slide ${i === 0 ? "active" : ""}`}
                  data-index={i}
                  data-notice-text={c.notice_text || ""}
                  data-notice-link={c.link_url || ""}
                >
                  {c.link_url ? <a href={c.link_url} class="block w-full h-full">{inner}</a> : inner}
                </div>
              );
            })}
          </div>
        </div>

        {campaigns.length > 1 && (
          <>
            <button type="button" id="prevBtn" class="slider-arrow prev" aria-label="前へ">‹</button>
            <button type="button" id="nextBtn" class="slider-arrow next" aria-label="次へ">›</button>
            <div class="flex gap-2 justify-center mt-7">
              {campaigns.map((_, i) => (
                <button
                  type="button"
                  class={`hero-dot ${i === 0 ? "active" : ""}`}
                  data-index={i}
                  aria-label={`スライド ${i + 1}`}
                />
              ))}
            </div>
          </>
        )}

        <div class="flex gap-4 justify-center flex-wrap mt-9">
          <a href="/contact" class="btn-cta btn-large">
            📋 お申込み・見積もり
          </a>
          <a href="tel:0592715908" class="btn-tel btn-large">
            📞 <span class="num-mont">059-271-5908</span>
          </a>
        </div>
      </div>
    ) : (
      <div class="relative max-w-[1240px] mx-auto px-4 md:px-8 py-12 md:py-20 grid md:grid-cols-2 gap-8 items-center z-[1]">
        <div>
          <span class="label-en">HOUSE CLEANING IN MIE</span>
          <h1 class="mt-4 text-4xl md:text-6xl font-black leading-[1.18] text-text" style="letter-spacing: -0.02em;">
            ありがとうの輪を、地域へ。<br />
            <span class="text-navy">三重のハウスクリーニング</span>
          </h1>
          <p class="mt-6 text-text-soft leading-[1.9]">
            津市・松阪市・鈴鹿市を中心に、店主が直接施工。<br class="hidden md:inline" />
            損害保険完備で、安心して任せられるクリーニングをお届けします。
          </p>
          <div class="mt-9 flex flex-col sm:flex-row gap-4">
            <a href="/contact" class="btn-cta btn-large">
              📋 お申込み・見積もり
            </a>
            <a href="tel:0592715908" class="btn-tel btn-large">
              📞 <span class="num-mont">059-271-5908</span>
            </a>
          </div>
        </div>
        <div class="hidden md:flex justify-center">
          <div class="w-80 h-80 rounded-full bg-white/60 backdrop-blur flex items-center justify-center text-[12rem]">
            🧽
          </div>
        </div>
      </div>
    )
  }
</section>

<style>
  .hero-blob {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }
  .hero-blob-1 {
    width: 580px;
    height: 580px;
    background: radial-gradient(circle, rgba(120, 200, 224, 0.30) 0%, transparent 70%);
    top: -260px;
    left: -200px;
  }
  .hero-blob-2 {
    width: 700px;
    height: 700px;
    background: radial-gradient(circle, rgba(194, 229, 239, 0.40) 0%, transparent 70%);
    bottom: -380px;
    right: -200px;
  }
  .slides-track {
    display: flex;
    gap: 24px;
    padding: 0 8vw;
    transition: transform 0.7s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .slide {
    flex: 0 0 84vw;
    aspect-ratio: 16 / 7;
    border-radius: 28px;
    box-shadow: 0 24px 80px rgba(30, 136, 176, 0.18);
    overflow: hidden;
    position: relative;
    transform: scale(0.95);
    opacity: 0.55;
    transition: transform 0.6s cubic-bezier(0.22, 0.61, 0.36, 1), opacity 0.6s;
    background: #f5fbfd;
  }
  .slide.active {
    transform: scale(1);
    opacity: 1;
  }
  .slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .slider-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: #FFF;
    border: none;
    cursor: pointer;
    box-shadow: 0 8px 24px rgba(30, 136, 176, 0.10);
    color: #1E88B0;
    font-size: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 3;
    transition: all 0.3s;
    line-height: 1;
    padding-bottom: 3px;
  }
  .slider-arrow:hover {
    background: #1E88B0;
    color: #FFF;
    transform: translateY(-50%) scale(1.05);
  }
  .slider-arrow.prev { left: 32px; }
  .slider-arrow.next { right: 32px; }
  @media (max-width: 768px) {
    .slider-arrow { display: none; }
    .slides-track { padding: 0 6vw; gap: 16px; }
    .slide { flex: 0 0 88vw; }
  }

  .hero-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #E1E8F0;
    border: none;
    cursor: pointer;
    padding: 0;
    transition: all 0.3s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .hero-dot:hover {
    background: #78c8e0;
  }
  .hero-dot.active {
    background: #1E88B0;
    width: 36px;
    border-radius: 999px;
  }
</style>

<script>
  const track = document.getElementById("slidesTrack");
  const slides = document.querySelectorAll<HTMLElement>(".slide");
  const dots = document.querySelectorAll<HTMLElement>(".hero-dot");
  const prevBtn = document.getElementById("prevBtn");
  const nextBtn = document.getElementById("nextBtn");
  const noticeBar = document.getElementById("noticeBar");
  const noticeText = document.getElementById("noticeText");
  const noticeLink = document.getElementById("noticeLink") as HTMLAnchorElement | null;
  let cur = 0;
  let timer: ReturnType<typeof setInterval> | null = null;

  function syncNotice(slide: HTMLElement) {
    if (!noticeBar || !noticeText) return;
    const text = slide.dataset.noticeText || "";
    const link = slide.dataset.noticeLink || "";
    if (text.trim().length === 0) {
      noticeBar.style.display = "none";
      return;
    }
    noticeBar.style.display = "";
    noticeText.textContent = text;
    if (noticeLink) {
      if (link) {
        noticeLink.setAttribute("href", link);
        noticeLink.style.pointerEvents = "auto";
        noticeLink.style.textDecoration = "underline";
      } else {
        noticeLink.removeAttribute("href");
        noticeLink.style.pointerEvents = "none";
        noticeLink.style.textDecoration = "none";
      }
    }
  }

  function show(i: number) {
    if (!track) return;
    cur = (i + slides.length) % slides.length;
    // 84vw + 24px gap = each slide slot
    const slideWidth = (window.innerWidth * 0.84) + 24;
    const offset = -cur * slideWidth;
    track.style.transform = `translateX(${offset}px)`;
    slides.forEach((s, idx) => s.classList.toggle("active", idx === cur));
    dots.forEach((d, idx) => d.classList.toggle("active", idx === cur));
    if (slides[cur]) syncNotice(slides[cur]);
  }

  function startTimer() {
    if (slides.length <= 1) return;
    if (timer) clearInterval(timer);
    timer = setInterval(() => show(cur + 1), 6000);
  }

  dots.forEach((d, i) => d.addEventListener("click", () => { show(i); startTimer(); }));
  prevBtn?.addEventListener("click", () => { show(cur - 1); startTimer(); });
  nextBtn?.addEventListener("click", () => { show(cur + 1); startTimer(); });
  window.addEventListener("resize", () => show(cur));

  if (slides[0]) syncNotice(slides[0]);
  startTimer();
</script>
