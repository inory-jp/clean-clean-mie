---
import Icon from "../Icon.astro";
import { getActiveCampaigns } from "../../lib/microcms";

const campaigns = await getActiveCampaigns();
const hasCampaigns = campaigns.length > 0;
---

<section class="hero relative overflow-hidden" style="background: linear-gradient(180deg, #FFF 0%, #F5FBFD 60%, #E8F5F9 100%); padding: 16px 0 48px;">
  <div class="hero-blob hero-blob-1" aria-hidden="true"></div>
  <div class="hero-blob hero-blob-2" aria-hidden="true"></div>
  <div class="hero-bubble b1" aria-hidden="true"></div>
  <div class="hero-bubble b2" aria-hidden="true"></div>
  <div class="hero-bubble b3" aria-hidden="true"></div>

  {
    hasCampaigns ? (
      <div class="relative z-[1]" id="heroSlider">
        <div class="slider-viewport overflow-hidden">
          <div class="slides-track" id="slidesTrack">
            {campaigns.map((c, i) => {
              const inner = (
                <picture>
                  {c.banner_image_sp && (
                    <source
                      media="(max-width: 767px)"
                      srcset={`${c.banner_image_sp.url}?w=750&fm=webp&q=85`}
                    />
                  )}
                  <img
                    src={`${c.banner_image_pc.url}?w=1920&fm=webp&q=85`}
                    alt={c.alt_text}
                    width={c.banner_image_pc.width}
                    height={c.banner_image_pc.height}
                    class="w-full h-full object-cover"
                    loading={i === 0 ? "eager" : "lazy"}
                  />
                </picture>
              );
              return (
                <div
                  class={`slide ${i === 0 ? "active" : ""}`}
                  data-index={i}
                  data-notice-text={c.notice_text || ""}
                  data-notice-link={c.link_url || ""}
                >
                  {c.link_url ? <a href={c.link_url} class="block w-full h-full">{inner}</a> : inner}
                </div>
              );
            })}
          </div>
        </div>

        {campaigns.length > 1 && (
          <>
            <button type="button" id="prevBtn" class="slider-arrow prev" aria-label="前へ">‹</button>
            <button type="button" id="nextBtn" class="slider-arrow next" aria-label="次へ">›</button>
            <div class="flex gap-2 justify-center mt-7">
              {campaigns.map((_, i) => (
                <button
                  type="button"
                  class={`hero-dot ${i === 0 ? "active" : ""}`}
                  data-index={i}
                  aria-label={`スライド ${i + 1}`}
                />
              ))}
            </div>
          </>
        )}

        <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center sm:flex-wrap mt-7 sm:mt-9 px-6">
          <a href="/contact" class="btn-cta btn-large w-full sm:w-auto">
            <Icon name="clipboard" size={18} /> お申込み・見積もり
          </a>
          <a href="tel:0592715908" class="btn-tel btn-large w-full sm:w-auto">
            <Icon name="phone" size={18} /> <span class="num-mont">059-271-5908</span>
          </a>
        </div>
        <div class="mt-5 px-4 text-center text-[11px] sm:text-xs text-muted leading-relaxed">
          対応エリア: 津・松阪・鈴鹿ほか三重県全域 ／ 損害保険完備 ／ 翌営業日中に一次返信
        </div>
      </div>
    ) : (
      <div class="relative max-w-[1240px] mx-auto px-4 md:px-8 py-12 md:py-20 grid md:grid-cols-2 gap-8 items-center z-[1]">
        <div>
          <span class="label-en">HOUSE CLEANING IN MIE</span>
          <h1 class="mt-4 text-3xl sm:text-4xl md:text-[52px] font-black leading-[1.2] text-text" style="letter-spacing: -0.02em;">
            津・松阪のエアコン、<br />
            <span class="text-navy">3時間で新品同様</span>に。
          </h1>
          <p class="mt-5 text-text-soft leading-[1.85] text-sm md:text-base">
            店主が直接施工。損害保険完備。三重県内出張費 無料。<br class="hidden md:inline" />
            分解洗浄でカビ・ホコリを徹底除去します。
          </p>
          <div class="mt-5 flex flex-wrap items-baseline gap-2 md:gap-3">
            <span class="num-mont text-accent text-3xl md:text-4xl font-black">¥12,100</span>
            <span class="text-xs md:text-sm text-muted">〜（壁掛け1台・税込）</span>
          </div>
          <div class="mt-7 md:mt-9 flex flex-col sm:flex-row gap-3 sm:gap-4">
            <a href="/contact" class="btn-cta btn-large">
              <Icon name="clipboard" size={18} /> お申込み・見積もり
            </a>
            <a href="tel:0592715908" class="btn-tel btn-large">
              <Icon name="phone" size={18} /> <span class="num-mont">059-271-5908</span>
            </a>
          </div>
        </div>
        <div class="hidden md:flex justify-center">
          <div class="w-80 h-80 rounded-full flex items-center justify-center text-navy" style="background: linear-gradient(135deg, #E8F5F9, #C2E5EF); box-shadow: 0 24px 80px rgba(30,136,176,0.18);">
            <Icon name="sparkle" size={140} />
          </div>
        </div>
      </div>
    )
  }
</section>

<style>
  .hero-blob {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }
  .hero-blob-1 {
    width: 580px;
    height: 580px;
    background: radial-gradient(circle, rgba(120, 200, 224, 0.30) 0%, transparent 70%);
    top: -260px;
    left: -200px;
  }
  .hero-blob-2 {
    width: 700px;
    height: 700px;
    background: radial-gradient(circle, rgba(194, 229, 239, 0.40) 0%, transparent 70%);
    bottom: -380px;
    right: -200px;
  }
  .slides-track {
    display: flex;
    gap: 24px;
    padding: 0 8vw;
    will-change: transform;
  }
  .slide {
    flex: 0 0 84vw;
    aspect-ratio: 12 / 5;
    border-radius: 28px;
    box-shadow: 0 24px 80px rgba(30, 136, 176, 0.18);
    overflow: hidden;
    position: relative;
    transform: scale(0.95);
    opacity: 0.55;
    transition: transform 0.6s cubic-bezier(0.22, 0.61, 0.36, 1), opacity 0.6s;
    background: #f5fbfd;
  }
  .slides-track.no-anim .slide {
    transition: none !important;
  }
  .slide.active {
    transform: scale(1);
    opacity: 1;
  }
  .slide picture,
  .slide a {
    display: block;
    width: 100%;
    height: 100%;
  }
  .slide img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center;
  }
  .slider-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: #FFF;
    border: none;
    cursor: pointer;
    box-shadow: 0 8px 24px rgba(30, 136, 176, 0.10);
    color: #1E88B0;
    font-size: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 3;
    transition: all 0.3s;
    line-height: 1;
    padding-bottom: 3px;
  }
  .slider-arrow:hover {
    background: #1E88B0;
    color: #FFF;
    transform: translateY(-50%) scale(1.05);
  }
  .slider-arrow.prev { left: 32px; }
  .slider-arrow.next { right: 32px; }
  @media (max-width: 768px) {
    .slider-arrow { display: none !important; }
    .slides-track { padding: 0 6vw; gap: 12px; }
    .slide {
      flex: 0 0 88vw;
      aspect-ratio: 5 / 6;
      border-radius: 20px;
    }
  }

  .hero-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #E1E8F0;
    border: none;
    cursor: pointer;
    padding: 0;
    transition: all 0.3s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .hero-dot:hover {
    background: #78c8e0;
  }
  .hero-dot.active {
    background: #1E88B0;
    width: 36px;
    border-radius: 999px;
  }
</style>

<script>
  const track = document.getElementById("slidesTrack") as HTMLElement | null;
  const realSlides = Array.from(document.querySelectorAll<HTMLElement>(".slide"));
  const dots = document.querySelectorAll<HTMLElement>(".hero-dot");
  const prevBtn = document.getElementById("prevBtn");
  const nextBtn = document.getElementById("nextBtn");
  const noticeBar = document.getElementById("noticeBar");
  const noticeText = document.getElementById("noticeText");
  const noticeLink = document.getElementById("noticeLink") as HTMLAnchorElement | null;
  const total = realSlides.length;
  let cur = 0;
  let pos = total > 1 ? 1 : 0;
  let animating = false;
  let timer: ReturnType<typeof setInterval> | null = null;
  const TRANSITION = "transform 0.7s cubic-bezier(0.22, 0.61, 0.36, 1)";

  // Insert clones for infinite loop
  if (track && total > 1) {
    const firstClone = realSlides[0].cloneNode(true) as HTMLElement;
    const lastClone = realSlides[total - 1].cloneNode(true) as HTMLElement;
    firstClone.classList.remove("active");
    lastClone.classList.remove("active");
    firstClone.dataset.clone = "1";
    lastClone.dataset.clone = "1";
    track.appendChild(firstClone);
    track.insertBefore(lastClone, track.firstChild);
  }

  const allSlides: HTMLElement[] = track
    ? Array.from(track.querySelectorAll<HTMLElement>(".slide"))
    : [];

  function getSlotWidth(): number {
    const first = allSlides[0];
    const second = allSlides[1];
    if (!first) return 0;
    // Use offsetLeft delta if two slides exist (handles different gap at breakpoints)
    if (second) return second.offsetLeft - first.offsetLeft;
    return first.offsetWidth;
  }

  function setTransform(px: number, animate: boolean) {
    if (!track) return;
    track.style.transition = animate ? TRANSITION : "none";
    track.style.transform = `translate3d(${px}px, 0, 0)`;
  }

  function applyPos(animate: boolean) {
    setTransform(-pos * getSlotWidth(), animate);
  }

  function setActive() {
    allSlides.forEach((s, i) => s.classList.toggle("active", i === pos));
    dots.forEach((d, idx) => d.classList.toggle("active", idx === cur));
    if (realSlides[cur]) syncNotice(realSlides[cur]);
  }

  function syncNotice(slide: HTMLElement) {
    if (!noticeBar || !noticeText) return;
    const text = slide.dataset.noticeText || "";
    const link = slide.dataset.noticeLink || "";
    if (text.trim().length === 0) {
      noticeBar.style.display = "none";
      return;
    }
    noticeBar.style.display = "";
    noticeText.textContent = text;
    if (noticeLink) {
      if (link) {
        noticeLink.setAttribute("href", link);
        noticeLink.style.pointerEvents = "auto";
        noticeLink.style.textDecoration = "underline";
      } else {
        noticeLink.removeAttribute("href");
        noticeLink.style.pointerEvents = "none";
        noticeLink.style.textDecoration = "none";
      }
    }
  }

  function snapBackIfNeeded() {
    if (total <= 1 || !track) return;
    if (pos === 0) {
      pos = total;
    } else if (pos === total + 1) {
      pos = 1;
    } else {
      return;
    }
    // Freeze all transitions (track + slides), snap, force reflow, then unfreeze
    track.classList.add("no-anim");
    track.style.transition = "none";
    track.style.transform = `translate3d(${-pos * getSlotWidth()}px, 0, 0)`;
    allSlides.forEach((s, i) => s.classList.toggle("active", i === pos));
    void track.offsetHeight;
    requestAnimationFrame(() => {
      track.classList.remove("no-anim");
    });
  }

  function next() {
    if (animating || total <= 1) return;
    animating = true;
    pos++;
    cur = (cur + 1) % total;
    applyPos(true);
    setActive();
  }

  function prev() {
    if (animating || total <= 1) return;
    animating = true;
    pos--;
    cur = (cur - 1 + total) % total;
    applyPos(true);
    setActive();
  }

  function jumpTo(i: number) {
    if (animating || total <= 1 || i === cur) return;
    animating = true;
    cur = i;
    pos = i + 1;
    applyPos(true);
    setActive();
  }

  if (track) {
    track.addEventListener("transitionend", (e) => {
      // Only handle transform end, ignore other properties
      if (e.target !== track) return;
      if ((e as TransitionEvent).propertyName !== "transform") return;
      animating = false;
      snapBackIfNeeded();
    });
  }

  function startTimer() {
    if (total <= 1) return;
    if (timer) clearInterval(timer);
    timer = setInterval(next, 6000);
  }

  dots.forEach((d, i) => d.addEventListener("click", () => { jumpTo(i); startTimer(); }));
  prevBtn?.addEventListener("click", () => { prev(); startTimer(); });
  nextBtn?.addEventListener("click", () => { next(); startTimer(); });
  window.addEventListener("resize", () => applyPos(false));

  // Touch / swipe support for mobile
  if (track && total > 1) {
    let startX = 0;
    let startY = 0;
    let dragging = false;
    let dragX = 0;
    const SWIPE_THRESHOLD = 50; // px to trigger swipe

    track.addEventListener("touchstart", (e) => {
      if (animating) return;
      startX = e.touches[0].clientX;
      startY = e.touches[0].clientY;
      dragging = true;
      dragX = 0;
    }, { passive: true });

    track.addEventListener("touchmove", (e) => {
      if (!dragging) return;
      const dx = e.touches[0].clientX - startX;
      const dy = e.touches[0].clientY - startY;
      // If vertical scroll dominates, abort swipe
      if (Math.abs(dy) > Math.abs(dx)) {
        dragging = false;
        return;
      }
      dragX = dx;
      // Live drag feedback (no animation)
      track.style.transition = "none";
      track.style.transform = `translate3d(${-pos * getSlotWidth() + dx}px, 0, 0)`;
    }, { passive: true });

    track.addEventListener("touchend", () => {
      if (!dragging) return;
      dragging = false;
      if (Math.abs(dragX) > SWIPE_THRESHOLD) {
        if (dragX < 0) next();
        else prev();
      } else {
        // Snap back
        applyPos(true);
      }
      startTimer();
    });
  }

  // initial layout: wait for first image so width is correct
  function init() {
    applyPos(false);
    setActive();
    startTimer();
  }

  const firstImg = track?.querySelector<HTMLImageElement>("img");
  if (firstImg && !firstImg.complete) {
    firstImg.addEventListener("load", () => applyPos(false), { once: true });
  }
  // Run twice: once now, once after a frame to let layout settle
  init();
  requestAnimationFrame(() => applyPos(false));
</script>
