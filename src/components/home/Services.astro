---
const services = [
  {
    href: "/service/aircon",
    image: "/assets/services/aircon.png",
    name: "エアコンクリーニング",
    meta: "分解洗浄でカビ・ホコリをすっきり除去。健康と省エネに。",
    tag: "★ 人気No.1",
    tagPopular: true,
    price: "12,100",
    features: ["壁掛け", "お掃除機能付", "天井埋込", "完全分解OP"],
    feature: true,
  },
  {
    href: "/service/bath",
    image: "/assets/services/bath.png",
    name: "お風呂クリーニング",
    meta: "浴室まるごと、エプロン内部のカビまで徹底洗浄。",
    tag: "セット割対象",
    price: "18,150",
    features: ["浴室まるごと", "エプロン内部", "鏡うろこ取り"],
  },
  {
    href: "/service/kitchen",
    image: "/assets/services/kitchen.png",
    name: "キッチン・換気扇",
    meta: "頑固な油汚れも分解洗浄で。吸い込み復活。",
    tag: "大掃除におすすめ",
    price: "12,100",
    features: ["レンジフード型", "プロペラ型"],
  },
  {
    href: "/service/other",
    image: "/assets/services/other.png",
    name: "その他クリーニング",
    meta: "水まわり・家電・窓まで、暮らしのあらゆる場所に。",
    tag: "幅広く対応",
    price: "9,680",
    features: ["トイレ", "洗面所", "洗濯機", "窓ガラス"],
  },
];

const featured = services[0];
const others = services.slice(1);
---

<section id="services" class="py-24 md:py-28 px-6 bg-white">
  <div class="max-w-[1240px] mx-auto">
    <div class="text-center mb-14">
      <span class="label-en">OUR SERVICES</span>
      <h2 class="section-h2 mt-2">
        清潔と安心を、<span class="accent">プロの技術で</span>
      </h2>
      <p class="text-muted mt-4 text-base leading-relaxed">
        ご家庭の主要な水回り・空調設備を、高品質な技術と専用機材で隅々まで美しく仕上げます。
      </p>
    </div>

    <div class="grid lg:grid-cols-3 gap-7">
      {/* Featured (1st card, takes 2 columns on desktop) */}
      <a
        href={featured.href}
        class="service-card lg:col-span-2 lg:row-span-2 group bg-white rounded-[28px] overflow-hidden shadow-sm hover:shadow-xl transition-shadow flex flex-col cursor-pointer relative"
      >
        <div class="absolute top-6 left-6 z-[2]">
          <span class="bg-accent text-white px-4 py-2 rounded-full text-xs font-extrabold tracking-wider shadow-md">
            {featured.tag}
          </span>
        </div>
        <div class="relative aspect-[16/10] overflow-hidden bg-sky-pale">
          <img
            src={featured.image}
            alt={featured.name}
            width="700"
            height="700"
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
          />
          <div class="absolute inset-0 pointer-events-none" style="background: linear-gradient(180deg, rgba(0,0,0,0) 50%, rgba(0,0,0,0.35) 100%);" />
        </div>
        <div class="p-8 md:p-10 flex-1 flex flex-col">
          <h3 class="text-navy text-2xl md:text-[28px] font-extrabold leading-tight">{featured.name}</h3>
          <p class="text-text-soft text-sm mt-3 leading-[1.85] max-w-md">{featured.meta}</p>
          <div class="flex gap-1.5 mt-5 flex-wrap">
            {featured.features.map((f) => (
              <span class="bg-sky-pale text-navy px-3 py-1 rounded text-xs font-semibold">{f}</span>
            ))}
          </div>
          <div class="flex items-baseline gap-2 mt-6 pt-5 border-t border-dashed border-line">
            <span class="text-xs text-muted">料金</span>
            <span class="num-mont text-accent text-[40px] font-bold leading-none" style="letter-spacing: -0.02em;">¥{featured.price}</span>
            <span class="text-muted text-xs">〜（税込）</span>
          </div>
          <span class="inline-flex items-center gap-2 text-navy font-bold text-sm mt-5">
            詳しく見る
            <span class="inline-block transition-transform duration-300 group-hover:translate-x-1">→</span>
          </span>
        </div>
      </a>

      {/* Others */}
      {others.map((s) => (
        <a
          href={s.href}
          class="service-card group bg-white rounded-[28px] overflow-hidden shadow-sm hover:shadow-xl transition-shadow flex flex-col cursor-pointer"
        >
          <div class="relative aspect-video overflow-hidden bg-sky-pale">
            <img
              src={s.image}
              alt={s.name}
              width="700"
              height="700"
              loading="lazy"
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
            />
            <div class="absolute inset-0 pointer-events-none" style="background: linear-gradient(180deg, rgba(0,0,0,0) 50%, rgba(0,0,0,0.35) 100%);" />
            <span class="absolute top-4 left-4 bg-white text-accent px-3 py-1 rounded-full text-[10px] font-extrabold tracking-wider shadow-sm">
              {s.tag}
            </span>
          </div>
          <div class="px-6 pt-5 pb-6 flex-1 flex flex-col">
            <h3 class="text-navy text-lg font-extrabold leading-tight">{s.name}</h3>
            <div class="flex items-baseline gap-1.5 mt-2 pt-3 border-t border-dashed border-line">
              <span class="num-mont text-accent text-[24px] font-bold leading-none">¥{s.price}</span>
              <span class="text-muted text-[10px]">〜（税込）</span>
            </div>
            <span class="inline-flex items-center gap-1 text-navy font-bold text-xs mt-3">
              詳しく見る <span class="inline-block transition-transform duration-300 group-hover:translate-x-1">→</span>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
