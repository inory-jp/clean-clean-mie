---
const voices = [
  {
    initial: "M",
    name: "M.K 様",
    date: "2026年4月",
    rating: 5,
    body: "エアコンの中がこんなに汚れているとは思いませんでした。完全分解で見違えるようにキレイに。栗田さんの丁寧な対応に感動しました。",
    service: "エアコンクリーニング",
  },
  {
    initial: "T",
    name: "T.S 様",
    date: "2026年3月",
    rating: 5,
    body: "時間通りに来ていただき、養生もしっかり、価格も明朗で安心できました。お風呂もエプロン内部まで開けて洗ってもらえて、満足です。",
    service: "お風呂クリーニング",
  },
  {
    initial: "A",
    name: "A.N 様",
    date: "2026年2月",
    rating: 4,
    body: "説明がわかりやすく、こちらの質問にも丁寧に答えてくれました。換気扇の油汚れがピカピカになって本当にうれしいです。",
    service: "キッチン・換気扇",
  },
];
---

<section id="voices" class="py-24 md:py-32 px-6 bg-bg-soft">
  <div class="max-w-[1240px] mx-auto">
    <div class="text-center mb-12">
      <span class="label-en">CUSTOMER VOICES</span>
      <h2 class="section-h2 mt-2">
        お客様の<span class="accent">ありがとう</span>
      </h2>
    </div>

    <div class="voices-rating">
      <div class="voices-rating-num">4.8</div>
      <div class="voices-rating-info">
        <div class="voices-rating-stars">★★★★★</div>
        <div class="voices-rating-count">クチコミ多数 ／ 5.0 満点</div>
        <a href="#" class="voices-rating-google">
          oogle ビジネスプロフィール
        </a>
      </div>
    </div>

    <div class="grid md:grid-cols-3 gap-7">
      {
        voices.map((v) => (
          <article class="voice-card">
            <div class="voice-head">
              <div class="voice-avatar">{v.initial}</div>
              <div>
                <div class="voice-name">{v.name}</div>
                <div class="voice-date">{v.date}</div>
              </div>
            </div>
            <div class="voice-stars">
              {"★".repeat(v.rating)}
              <span style="color: #E1E8F0;">{"★".repeat(5 - v.rating)}</span>
            </div>
            <p class="voice-text">{v.body}</p>
            <div class="voice-meta">
              <span>{v.service}</span>
              <span class="voice-google">Google</span>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .voices-rating {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 32px;
    margin: 0 auto 56px;
    padding: 32px 40px;
    background: #FFF;
    border-radius: 28px;
    max-width: 600px;
    box-shadow: 0 2px 8px rgba(30, 136, 176, 0.08);
    flex-wrap: wrap;
  }
  .voices-rating-num {
    font-family: "Montserrat", sans-serif;
    font-size: 72px;
    font-weight: 700;
    color: #FF7A45;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .voices-rating-info {
    line-height: 1.6;
  }
  .voices-rating-stars {
    color: #FFC107;
    font-size: 26px;
    letter-spacing: 4px;
    margin-bottom: 4px;
    text-shadow: 0 1px 3px rgba(255, 193, 7, 0.30);
  }
  .voices-rating-count {
    color: #6B7A8F;
    font-size: 14px;
  }
  .voices-rating-google {
    color: #4285F4;
    font-weight: 700;
    font-size: 13px;
    margin-top: 4px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .voices-rating-google::before {
    content: "G";
    width: 16px;
    height: 16px;
    background: #4285F4;
    color: #FFF;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    font-weight: 900;
  }
  .voice-card {
    background: #FFF;
    padding: 32px;
    border-radius: 20px;
    box-shadow: 0 2px 8px rgba(30, 136, 176, 0.08);
    position: relative;
    transition: transform 0.3s cubic-bezier(0.22, 0.61, 0.36, 1), box-shadow 0.3s;
  }
  .voice-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(30, 136, 176, 0.10);
  }
  .voice-card::before {
    content: "“";
    position: absolute;
    top: -8px;
    left: 24px;
    font-size: 90px;
    color: #C2E5EF;
    font-family: Georgia, serif;
    line-height: 1;
    pointer-events: none;
  }
  .voice-head {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
    position: relative;
  }
  .voice-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: linear-gradient(135deg, #E8F5F9, #78C8E0);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FFF;
    font-weight: 900;
    font-size: 20px;
    box-shadow: 0 4px 12px rgba(120, 200, 224, 0.40);
  }
  .voice-name {
    font-weight: 700;
    font-size: 14px;
  }
  .voice-date {
    font-size: 11px;
    color: #6B7A8F;
  }
  .voice-stars {
    color: #FFC107;
    font-size: 16px;
    letter-spacing: 1px;
    margin-bottom: 14px;
  }
  .voice-text {
    font-size: 14px;
    color: #3F4E63;
    line-height: 1.9;
  }
  .voice-meta {
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid #E1E8F0;
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    color: #6B7A8F;
    align-items: center;
  }
  .voice-google {
    color: #4285F4;
    font-weight: 700;
  }
</style>
