---
const voices = [
  {
    initial: "M",
    name: "M.K 様",
    date: "2026年4月",
    rating: 5,
    body: "エアコンの中がこんなに汚れているとは思いませんでした。分解洗浄で見違えるようにキレイに。栗田さんの丁寧な対応に感動しました。",
    service: "エアコンクリーニング",
    avatarBg: "linear-gradient(135deg, #4FC3F7, #1E88B0)",
  },
  {
    initial: "T",
    name: "T.S 様",
    date: "2026年3月",
    rating: 5,
    body: "時間通りに来ていただき、養生もしっかり、価格も明朗で安心できました。お風呂も追い焚き配管の中まで除菌洗浄してもらえて、満足です。",
    service: "お風呂クリーニング",
    avatarBg: "linear-gradient(135deg, #FFB088, #FF7A45)",
  },
  {
    initial: "A",
    name: "A.N 様",
    date: "2026年2月",
    rating: 4,
    body: "説明がわかりやすく、こちらの質問にも丁寧に答えてくれました。換気扇の油汚れがピカピカになって本当にうれしいです。",
    service: "キッチン・換気扇",
    avatarBg: "linear-gradient(135deg, #81C784, #2E7D32)",
  },
];
---

<section id="voices" class="py-16 md:py-24 px-5 md:px-6 bg-bg-soft">
  <div class="max-w-[1240px] mx-auto">
    <div class="text-center mb-12">
      <span class="label-en">CUSTOMER VOICES</span>
      <h2 class="section-h2 mt-2">
        お客様の<span class="accent">ありがとう</span>
      </h2>
      <p class="text-muted mt-4 text-sm">
        ※ 表示しているクチコミは公開準備中のサンプルです。公開後は<br class="md:hidden" />Googleビジネスプロフィールの最新クチコミを自動取得して表示します。
      </p>
    </div>

    {/* Google-style review summary */}
    <div class="max-w-3xl mx-auto bg-white rounded-2xl shadow-sm p-5 md:p-8 mb-10 md:mb-12 border border-line-soft">
      <div class="flex items-center gap-3 md:gap-5 flex-wrap justify-center md:justify-start">
        <div class="flex items-center gap-2">
          <svg viewBox="0 0 24 24" width="32" height="32" aria-hidden="true">
            <path fill="#4285F4" d="M22.5 12.27c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.15-4.53H2.17v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.85 14.1c-.22-.66-.35-1.36-.35-2.1s.13-1.44.35-2.1V7.07H2.17C1.43 8.55 1 10.22 1 12s.43 3.45 1.17 4.93l3.68-2.83z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.17 7.07l3.68 2.84C6.71 7.31 9.14 5.38 12 5.38z"/>
          </svg>
          <span class="font-bold text-text">Google</span>
        </div>
        <div class="h-10 w-px bg-line"></div>
        <div class="flex items-center gap-3">
          <span class="num-mont text-[44px] text-text font-bold leading-none">4.8</span>
          <div>
            <div class="text-gold text-base tracking-wider leading-none">★★★★★</div>
            <div class="text-xs text-muted mt-1.5">5.0 満点中</div>
          </div>
        </div>
        <a href="#" class="md:ml-auto w-full md:w-auto text-center md:text-left text-sm font-bold text-[#4285F4] hover:underline">
          すべてのクチコミを見る →
        </a>
      </div>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      {
        voices.map((v) => (
          <article class="bg-white rounded-2xl p-6 border border-line-soft hover:shadow-md transition-shadow">
            <div class="flex items-start gap-3 mb-4">
              <div
                class="w-10 h-10 rounded-full flex items-center justify-center text-white font-extrabold text-sm shrink-0"
                style={`background: ${v.avatarBg};`}
              >
                {v.initial}
              </div>
              <div class="flex-1 min-w-0">
                <div class="font-bold text-text text-sm">{v.name}</div>
                <div class="text-[11px] text-muted">ローカルガイド · {v.date}</div>
              </div>
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" class="shrink-0">
                <path fill="#4285F4" d="M22.5 12.27c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.15-4.53H2.17v2.84C3.99 20.53 7.7 23 12 23z"/>
                <path fill="#FBBC05" d="M5.85 14.1c-.22-.66-.35-1.36-.35-2.1s.13-1.44.35-2.1V7.07H2.17C1.43 8.55 1 10.22 1 12s.43 3.45 1.17 4.93l3.68-2.83z"/>
                <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.17 7.07l3.68 2.84C6.71 7.31 9.14 5.38 12 5.38z"/>
              </svg>
            </div>
            <div class="text-gold text-sm tracking-wider mb-3">
              {"★".repeat(v.rating)}
              <span style="color: #E1E8F0;">{"★".repeat(5 - v.rating)}</span>
            </div>
            <p class="text-text-soft text-sm leading-[1.85]">{v.body}</p>
            <div class="mt-4 pt-3 border-t border-line-soft text-xs text-muted">
              依頼内容: <span class="font-bold text-navy">{v.service}</span>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
