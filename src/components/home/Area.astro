---
const primaryAreas = ["津市", "松阪市", "鈴鹿市"];
const otherAreas = ["伊勢市", "名張市", "伊賀市", "亀山市", "桑名市", "他三重県全域"];

const pins = [
  { city: "津", top: "42%", left: "50%" },
  { city: "松阪", top: "51%", left: "54%" },
  { city: "鈴鹿", top: "34%", left: "58%" },
];
---

<section id="area" class="relative py-24 md:py-28 px-6 overflow-hidden bg-gradient-to-br from-white via-sky-mist to-sky-pale">
  <div class="absolute -top-40 -right-40 w-[600px] h-[600px] rounded-full pointer-events-none" style="background: radial-gradient(circle, rgba(120,200,224,0.30) 0%, transparent 70%);"></div>

  <div class="relative max-w-[1240px] mx-auto">
    <div class="text-center mb-12">
      <span class="label-en">SERVICE AREA</span>
      <h2 class="section-h2 mt-2">
        三重県全域に<span class="accent">対応しています</span>
      </h2>
      <p class="text-muted mt-4 text-sm">
        津市・松阪市・鈴鹿市を中心に、三重県全域へお伺いします
      </p>
    </div>

    {/* Big map with floating city tags */}
    <div class="relative bg-white rounded-[32px] shadow-xl p-6 md:p-12 max-w-5xl mx-auto">
      <div class="relative max-w-2xl mx-auto">
        <img
          src="/assets/mie-map.png"
          alt="三重県エリアマップ"
          class="w-full h-auto"
        />
        {
          pins.map((p, idx) => (
            <div
              class="absolute -translate-x-1/2 -translate-y-full"
              style={`top: ${p.top}; left: ${p.left};`}
            >
              <div class="relative">
                {idx === 0 && (
                  <span class="absolute inset-0 rounded-full bg-accent/40 animate-ping" style="width: 18px; height: 18px;"></span>
                )}
                <span class="relative block w-[18px] h-[18px] rounded-full bg-accent shadow-md ring-2 ring-white"></span>
                <span class="absolute top-full left-1/2 -translate-x-1/2 mt-1.5 whitespace-nowrap text-xs font-black text-accent-deep bg-white px-2 py-0.5 rounded shadow-md border border-accent/30">
                  {p.city}
                </span>
              </div>
            </div>
          ))
        }

        {/* Floating city tags surrounding the map */}
        <div class="hidden md:block absolute -left-4 top-1/4 -translate-x-full">
          <div class="bg-white rounded-2xl shadow-md px-4 py-3 border border-line-soft text-center min-w-[100px]">
            <div class="text-[10px] text-muted font-bold tracking-wider mb-1">主要</div>
            <div class="text-navy font-extrabold text-sm">津市</div>
          </div>
        </div>
        <div class="hidden md:block absolute -right-4 top-1/3 translate-x-full">
          <div class="bg-white rounded-2xl shadow-md px-4 py-3 border border-line-soft text-center min-w-[100px]">
            <div class="text-[10px] text-muted font-bold tracking-wider mb-1">主要</div>
            <div class="text-navy font-extrabold text-sm">鈴鹿市</div>
          </div>
        </div>
        <div class="hidden md:block absolute -left-4 bottom-1/4 -translate-x-full">
          <div class="bg-white rounded-2xl shadow-md px-4 py-3 border border-line-soft text-center min-w-[100px]">
            <div class="text-[10px] text-muted font-bold tracking-wider mb-1">主要</div>
            <div class="text-navy font-extrabold text-sm">松阪市</div>
          </div>
        </div>
      </div>

      {/* Mobile-friendly area tags */}
      <div class="md:hidden mt-7">
        <div class="text-xs text-muted font-bold mb-2 tracking-wider text-center">主要対応エリア</div>
        <div class="flex flex-wrap gap-2 justify-center">
          {primaryAreas.map((a) => (
            <span class="bg-navy text-white text-sm font-bold px-4 py-1.5 rounded-full">{a}</span>
          ))}
        </div>
      </div>

      {/* Stats + other areas (always visible) */}
      <div class="mt-10 pt-8 border-t border-line-soft grid md:grid-cols-3 gap-5">
        <div class="text-center">
          <div class="num-mont text-2xl text-navy font-extrabold">三重県全域</div>
          <div class="text-xs text-muted mt-1.5">対応エリア</div>
        </div>
        <div class="text-center">
          <div class="num-mont text-2xl text-accent-deep font-extrabold">無料</div>
          <div class="text-xs text-muted mt-1.5">県内出張費</div>
        </div>
        <div class="text-center">
          <div class="num-mont text-2xl text-navy font-extrabold">即日相談OK</div>
          <div class="text-xs text-muted mt-1.5">お見積もり</div>
        </div>
      </div>

      <div class="mt-8 pt-6 border-t border-line-soft">
        <div class="text-xs text-muted font-bold mb-3 tracking-wider">その他対応エリア</div>
        <div class="flex flex-wrap gap-2">
          {otherAreas.map((a) => (
            <span class="bg-bg-soft text-text-soft text-xs px-3 py-1.5 rounded-full border border-line-soft">{a}</span>
          ))}
        </div>
      </div>
    </div>

    <div class="max-w-2xl mx-auto mt-8 text-center text-sm text-text-soft">
      エリア外の方もまずはお気軽にご相談ください。
    </div>
  </div>
</section>
