---
---

<section id="area" class="relative py-16 md:py-28 px-5 md:px-6 overflow-hidden bg-gradient-to-br from-white via-sky-mist to-sky-pale">
  <div class="absolute -top-40 -right-40 w-[600px] h-[600px] rounded-full pointer-events-none" style="background: radial-gradient(circle, rgba(120,200,224,0.30) 0%, transparent 70%);"></div>

  <div class="relative max-w-[1240px] mx-auto">
    <div class="text-center mb-12">
      <span class="label-en">SERVICE AREA</span>
      <h2 class="section-h2 mt-2">
        三重県全域に<span class="accent">対応しています</span>
      </h2>
      <p class="text-muted mt-4 text-sm">
        津市を中心に、三重県全域へお伺いします
      </p>
    </div>

    <div class="bg-white rounded-[24px] md:rounded-[32px] shadow-xl p-5 md:p-12 max-w-5xl mx-auto">
      <div class="area-map-wrap">
        <img
          src="/assets/mie-map.png"
          alt="三重県エリアマップ"
          class="w-full h-auto relative z-[1]"
        />
        <div class="ripple-container" aria-hidden="true">
          <span class="ripple-gradient"></span>
          <span class="ripple ripple-1"></span>
          <span class="ripple ripple-2"></span>
          <span class="ripple ripple-3"></span>
          <span class="ripple-core"></span>
        </div>
      </div>

      <div class="mt-8 md:mt-10 pt-6 md:pt-8 border-t border-line-soft grid grid-cols-3 gap-3 md:gap-5">
        <div class="text-center">
          <div class="num-mont text-base md:text-2xl text-navy font-extrabold leading-tight">三重県全域</div>
          <div class="text-[10px] md:text-xs text-muted mt-1 md:mt-1.5">対応エリア</div>
        </div>
        <div class="text-center">
          <div class="num-mont text-base md:text-2xl text-accent-deep font-extrabold leading-tight">無料</div>
          <div class="text-[10px] md:text-xs text-muted mt-1 md:mt-1.5">県内出張費</div>
        </div>
        <div class="text-center">
          <div class="num-mont text-sm md:text-2xl text-navy font-extrabold leading-tight">即日相談OK</div>
          <div class="text-[10px] md:text-xs text-muted mt-1 md:mt-1.5">お見積もり</div>
        </div>
      </div>

    </div>

    <div class="max-w-2xl mx-auto mt-8 text-center text-sm text-text-soft">
      エリア外の方もまずはお気軽にご相談ください。
    </div>
  </div>
</section>

<style>
  .area-map-wrap {
    position: relative;
    max-width: 640px;
    margin: 0 auto;
  }

  /* Center coordinates for Tsu (matches map's Tsu position) */
  .ripple-container {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
  }

  /* Subtle radial gradient covering the prefecture */
  .ripple-gradient {
    position: absolute;
    top: 50%;
    left: 56%;
    width: 70%;
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(255, 122, 69, 0.22) 0%,
      rgba(255, 122, 69, 0.10) 40%,
      transparent 70%
    );
    mix-blend-mode: multiply;
  }

  /* Pulsing core dot at Tsu */
  .ripple-core {
    position: absolute;
    top: 50%;
    left: 56%;
    width: 14px;
    height: 14px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: #FF7A45;
    box-shadow: 0 0 0 2px #fff, 0 4px 12px rgba(255, 122, 69, 0.45);
    z-index: 3;
  }

  /* Ripple rings */
  .ripple {
    position: absolute;
    top: 50%;
    left: 56%;
    width: 14px;
    height: 14px;
    transform: translate(-50%, -50%) scale(1);
    border-radius: 50%;
    border: 2px solid #FF7A45;
    opacity: 0;
    animation: ripple-spread 4s cubic-bezier(0, 0.55, 0.45, 1) infinite;
  }
  .ripple-1 { animation-delay: 0s; }
  .ripple-2 { animation-delay: 1.3s; }
  .ripple-3 { animation-delay: 2.6s; }

  @keyframes ripple-spread {
    0% {
      transform: translate(-50%, -50%) scale(1);
      opacity: 0.7;
      border-width: 2px;
    }
    80% {
      opacity: 0.05;
      border-width: 1px;
    }
    100% {
      transform: translate(-50%, -50%) scale(28);
      opacity: 0;
      border-width: 1px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ripple {
      animation: none;
      opacity: 0.3;
    }
  }
</style>
