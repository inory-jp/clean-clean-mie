---
const steps = [
  {
    no: "01",
    title: "お申込み・お見積もり",
    body: "フォーム・電話・LINEからお気軽にどうぞ。料金の目安をその場でご確認いただけます。",
    icon: "📋",
    duration: "5〜10分",
  },
  {
    no: "02",
    title: "日程調整・内容確認",
    body: "栗田より折り返しご連絡。希望日時を確認のうえ、施工内容を最終調整します。",
    icon: "📅",
    duration: "翌営業日中",
  },
  {
    no: "03",
    title: "当日施工",
    body: "養生・分解・高圧洗浄・組立まで一貫対応。店主が直接施工します。",
    icon: "🧴",
    duration: "1〜4時間",
  },
  {
    no: "04",
    title: "仕上げ確認・ご説明",
    body: "仕上がりを一緒にご確認。気になる点や次回のお手入れもお伝えします。",
    icon: "✨",
    duration: "10〜15分",
  },
  {
    no: "FINISH",
    title: "お支払い・完了",
    body: "作業完了後にお支払い。現金または銀行振込が可能です。領収書も発行可。",
    icon: "✅",
    duration: "その場で",
  },
];
---

<section id="flow" class="py-24 md:py-32 px-6 bg-white">
  <div class="max-w-[1240px] mx-auto">
    <div class="text-center mb-16">
      <span class="label-en">SERVICE FLOW</span>
      <h2 class="section-h2 mt-2">
        施工の<span class="accent">流れ</span>
      </h2>
      <p class="text-muted mt-4 text-base leading-relaxed">
        初めての方でも安心。シンプルな5ステップでスムーズにご利用いただけます。
      </p>
    </div>

    <ol class="grid sm:grid-cols-2 lg:grid-cols-5 gap-5">
      {
        steps.map((s, i) => (
          <li class="bg-white rounded-[24px] p-6 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all relative">
            <div
              class="num-mont absolute -top-3 left-6 px-3 py-1 rounded-full bg-navy text-white text-[10px] font-bold shadow-sm"
              style="letter-spacing: 0.1em;"
            >
              STEP {s.no}
            </div>
            <div
              class="w-14 h-14 mt-3 mb-5 rounded-2xl flex items-center justify-center text-2xl"
              style="background: linear-gradient(135deg, #E8F5F9, #C2E5EF); box-shadow: 0 4px 12px rgba(120,200,224,0.25);"
            >
              {s.icon}
            </div>
            <h3 class="font-extrabold text-navy text-base leading-tight mb-2">{s.title}</h3>
            <p class="text-text-soft text-xs leading-relaxed">{s.body}</p>
            <div class="mt-4 inline-block bg-sky-pale text-navy-deep text-[10px] font-bold px-2.5 py-1 rounded-full">
              ⏱ {s.duration}
            </div>
            {i < steps.length - 1 && (
              <span class="hidden lg:flex absolute top-1/2 -right-3 -translate-y-1/2 text-sky-light text-2xl items-center">
                →
              </span>
            )}
          </li>
        ))
      }
    </ol>
  </div>
</section>
