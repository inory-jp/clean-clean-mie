---
const steps = [
  {
    no: "01",
    title: "お申込み・お見積もり",
    body: "フォーム・電話・LINEからお気軽にどうぞ。料金の目安をその場でご確認いただけます。",
    duration: "5〜10分",
    svg: '<path d="M9 2h6c1.1 0 2 .9 2 2v1h2c1.1 0 2 .9 2 2v13c0 1.1-.9 2-2 2H5c-1.1 0-2-.9-2-2V7c0-1.1.9-2 2-2h2V4c0-1.1.9-2 2-2zm0 2v2h6V4H9zm-2 8h10v-1.5H7V12zm0 4h10v-1.5H7V16zm0 4h7v-1.5H7V20z"/>',
  },
  {
    no: "02",
    title: "日程調整・内容確認",
    body: "栗田より折り返しご連絡。希望日時を確認のうえ、施工内容を最終調整します。",
    duration: "翌営業日中",
    svg: '<path d="M19 4h-1V2h-2v2H8V2H6v2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 16H5V10h14v10zM5 8V6h14v2H5zm6 4h2v2h-2v-2zm-4 0h2v2H7v-2zm8 0h2v2h-2v-2zm-4 4h2v2h-2v-2zm-4 0h2v2H7v-2zm8 0h2v2h-2v-2z"/>',
  },
  {
    no: "03",
    title: "当日施工",
    body: "養生・分解・高圧洗浄・組立まで一貫対応。店主が直接施工します。",
    duration: "1〜4時間",
    svg: '<path d="M14 4l7-2v2l-7 2V4zM9 2h4v4l1 3v11a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V9l1-3h0V2h2zm0 2v2h2V4H9zm-2 7v9h6v-9l-1-3h-4l-1 3z"/>',
  },
  {
    no: "04",
    title: "仕上げ確認・ご説明",
    body: "仕上がりを一緒にご確認。気になる点や次回のお手入れもお伝えします。",
    duration: "10〜15分",
    svg: '<path d="M12 2l2.6 6.4L21 10l-5 4.5 1.6 6.5L12 17.5 6.4 21 8 14.5 3 10l6.4-1.6L12 2z"/>',
  },
  {
    no: "FINISH",
    title: "お支払い・完了",
    body: "作業完了後にお支払い。現金または銀行振込が可能です。領収書も発行可。",
    duration: "その場で",
    svg: '<path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm-1.4 14.6L6 12l1.4-1.4 3.2 3.2 6-6L18 9.2l-7.4 7.4z"/>',
    isFinish: true,
  },
];
---

<section id="flow" class="py-16 md:py-32 px-5 md:px-6 bg-white">
  <div class="max-w-[1240px] mx-auto">
    <div class="text-center mb-16">
      <span class="label-en">SERVICE FLOW</span>
      <h2 class="section-h2 mt-2">
        施工の<span class="accent">流れ</span>
      </h2>
      <p class="text-muted mt-4 text-base leading-relaxed">
        初めての方でも安心。シンプルな5ステップでスムーズにご利用いただけます。
      </p>
    </div>

    <div class="flow-wrap relative max-w-[1200px] mx-auto">
      <div class="flow-progress hidden lg:block"></div>
      <div class="flow-grid grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-5 lg:gap-4 relative z-[1]">
        {
          steps.map((s) => (
            <div class={`flow-step text-center relative ${s.isFinish ? "is-finish" : ""}`}>
              <div class="flow-step-num">
                <div class="flow-step-num-inner">
                  <small>STEP</small>
                  {s.no}
                </div>
              </div>
              <div class="flow-card">
                <div class="flow-card-icon">
                  <svg viewBox="0 0 24 24" fill="currentColor" set:html={s.svg} />
                </div>
                <h4>{s.title}</h4>
                <p>{s.body}</p>
                <span class="flow-card-time"><svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor" aria-hidden="true"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/></svg> {s.duration}</span>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .flow-progress {
    position: absolute;
    top: 38px;
    left: 8%;
    right: 8%;
    height: 4px;
    background: #E1E8F0;
    border-radius: 2px;
    z-index: 0;
  }
  .flow-progress::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, #78C8E0, #4FB0CE 75%, #FF7A45);
    border-radius: 2px;
  }
  .flow-step {
    position: relative;
  }
  .flow-step-num {
    width: 76px;
    height: 76px;
    margin: 0 auto 20px;
    border-radius: 50%;
    background: #FFF;
    border: 4px solid #78C8E0;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 2;
    box-shadow: 0 6px 20px rgba(30, 136, 176, 0.10);
    transition: all 0.3s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .flow-step:hover .flow-step-num {
    transform: scale(1.06);
    box-shadow: 0 10px 28px rgba(30, 136, 176, 0.18);
    border-color: #FF7A45;
  }
  .flow-step-num-inner {
    font-family: "Montserrat", sans-serif;
    font-size: 20px;
    font-weight: 700;
    color: #1E88B0;
    letter-spacing: -0.02em;
    line-height: 1;
    text-align: center;
  }
  .flow-step-num-inner small {
    display: block;
    font-size: 9px;
    color: #6B7A8F;
    letter-spacing: 0.15em;
    margin-bottom: 2px;
    font-weight: 600;
  }
  .flow-step.is-finish .flow-step-num {
    border-color: #FF7A45;
    background: linear-gradient(135deg, #FF7A45, #FFB088);
  }
  .flow-step.is-finish .flow-step-num-inner,
  .flow-step.is-finish .flow-step-num-inner small {
    color: #FFF;
  }
  .flow-card {
    background: #FFF;
    border-radius: 20px;
    padding: 24px 20px 22px;
    box-shadow: 0 2px 8px rgba(30, 136, 176, 0.08);
    transition: transform 0.3s cubic-bezier(0.22, 0.61, 0.36, 1), box-shadow 0.3s, border-color 0.3s;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    border: 1px solid #EEF2F7;
  }
  .flow-step:hover .flow-card {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(30, 136, 176, 0.10);
    border-color: #C2E5EF;
  }
  .flow-card-icon {
    width: 56px;
    height: 56px;
    border-radius: 16px;
    background: linear-gradient(135deg, #E8F5F9, #C2E5EF);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 14px;
    color: #1E88B0;
  }
  .flow-card-icon svg {
    width: 30px;
    height: 30px;
  }
  .flow-step.is-finish .flow-card-icon {
    background: linear-gradient(135deg, #FFE0B2, #FFB088);
    color: #E55F2C;
  }
  .flow-card h4 {
    font-size: 15px;
    color: #1E88B0;
    margin-bottom: 10px;
    font-weight: 700;
    line-height: 1.5;
  }
  .flow-card p {
    font-size: 12px;
    color: #3F4E63;
    line-height: 1.8;
    margin-bottom: 14px;
    flex: 1;
  }
  .flow-card-time {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 12px;
    background: #F7FAFC;
    color: #6B7A8F;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 600;
  }
  .flow-step.is-finish .flow-card-time {
    background: rgba(255, 122, 69, 0.10);
    color: #FF7A45;
  }
</style>
