---
import Icon from "../Icon.astro";
const tel = "059-271-5908";
const telHref = "tel:0592715908";
---

<section class="py-24 md:py-28 px-6 bg-bg-soft">
  <div class="max-w-4xl mx-auto">
    <div class="text-center mb-10">
      <span class="label-en">CONTACT</span>
      <h2 class="section-h2 mt-3" style="font-size: 32px; line-height: 1.2;">
        料金が<span class="accent">即わかる</span>。<br />
        まずは<span class="text-navy">お見積もり</span>から。
      </h2>
      <p class="text-text-soft mt-5 leading-relaxed">
        メニューを選ぶだけで料金を自動計算。送信後、栗田より折り返しご連絡いたします。
      </p>
    </div>

    <div class="bg-white rounded-[28px] shadow-xl p-7 md:p-10 border border-line-soft">
      <div class="grid md:grid-cols-2 gap-5">
        {/* Primary: form */}
        <a
          href="/contact"
          class="group relative flex flex-col items-center justify-center text-center bg-accent text-white rounded-2xl p-7 md:p-9 hover:bg-accent-deep transition-colors shadow-orange"
        >
          <span class="absolute -top-3 left-1/2 -translate-x-1/2 bg-gold text-text text-[10px] font-black px-3 py-1 rounded-full whitespace-nowrap">
            ★ おすすめ
          </span>
          <Icon name="clipboard" size={28} />
          <div class="mt-3 text-base md:text-lg font-extrabold">お申込み・見積もり</div>
          <div class="mt-1 text-[11px] opacity-90">カート式で料金が即わかる</div>
          <div class="mt-4 text-xs font-bold inline-flex items-center gap-1">
            進む <span class="inline-block transition-transform duration-300 group-hover:translate-x-1">→</span>
          </div>
        </a>

        {/* Secondary: phone */}
        <a
          href={telHref}
          class="flex flex-col items-center justify-center text-center bg-white border-2 border-navy text-navy rounded-2xl p-7 md:p-9 hover:bg-sky-pale transition-colors"
        >
          <Icon name="phone" size={28} />
          <div class="mt-3 text-base md:text-lg font-extrabold">お電話でのご相談</div>
          <div class="num-mont text-2xl md:text-3xl mt-2" style="letter-spacing: 0.04em;">{tel}</div>
          <div class="mt-3 text-[11px] text-muted">9:00〜18:00 ／ 不定休</div>
        </a>
      </div>

      <div class="mt-7 pt-6 border-t border-line-soft flex flex-wrap gap-x-7 gap-y-2 justify-center text-xs text-text-soft">
        <span class="flex items-center gap-1.5">
          <Icon name="check" size={14} class="text-accent" />
          翌営業日中に一次返信
        </span>
        <span class="flex items-center gap-1.5">
          <Icon name="check" size={14} class="text-accent" />
          見積もりキャンセル無料
        </span>
        <span class="flex items-center gap-1.5">
          <Icon name="check" size={14} class="text-accent" />
          損害保険完備
        </span>
        <span class="flex items-center gap-1.5">
          <Icon name="check" size={14} class="text-accent" />
          三重県内出張費 無料
        </span>
      </div>
    </div>
  </div>
</section>
