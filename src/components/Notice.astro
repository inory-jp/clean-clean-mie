---
import { getActiveCampaigns } from "../lib/microcms";

const campaigns = await getActiveCampaigns();
const hasAnyNotice = campaigns.some(
  (c) => c.notice_text && c.notice_text.trim().length > 0,
);
---

{
  hasAnyNotice && (
    <div id="noticeBar" class="bg-navy-deep text-white text-xs py-2 px-4 text-center">
      <strong class="text-gold font-bold mr-2">📢 NEWS</strong>
      <a
        id="noticeLink"
        href="#"
        class="hover:underline"
        style="pointer-events: none; color: inherit; text-decoration: none;"
      >
        <span id="noticeText" />
      </a>
      <span class="hidden sm:inline ml-3 text-sky-light">
        ／ お電話でのご相談も歓迎 059-271-5908
      </span>
    </div>
  )
}
