---
import { getActiveCampaigns } from "../lib/microcms";

const campaigns = await getActiveCampaigns();
const notice = campaigns.find((c) => c.notice_text && c.notice_text.trim().length > 0);
---

{
  notice && (
    <div class="bg-navy-deep text-white text-xs py-2 px-4 text-center">
      <strong class="text-gold font-bold mr-2">📢 NEWS</strong>
      {notice.link_url ? (
        <a href={notice.link_url} class="hover:underline">
          {notice.notice_text}
        </a>
      ) : (
        notice.notice_text
      )}
      <span class="hidden sm:inline ml-3 text-sky-light">
        ／ お電話でのご相談も歓迎 059-271-5908
      </span>
    </div>
  )
}
