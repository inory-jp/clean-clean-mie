---
import Icon from "./Icon.astro";
import { getActiveCampaigns } from "../lib/microcms";

const campaigns = await getActiveCampaigns();
const hasAnyNotice = campaigns.some(
  (c) => c.notice_text && c.notice_text.trim().length > 0,
);
---

{
  hasAnyNotice && (
    <div id="noticeBar" class="bg-navy-deep text-white text-xs py-2 px-4 text-center flex items-center justify-center gap-2 flex-wrap">
      <span class="inline-flex items-center gap-1.5 text-gold font-bold">
        <Icon name="megaphone" size={14} /> NEWS
      </span>
      <a
        id="noticeLink"
        href="#"
        class="hover:underline"
        style="pointer-events: none; color: inherit; text-decoration: none;"
      >
        <span id="noticeText" />
      </a>
      <span class="hidden sm:inline-flex items-center gap-1.5 text-sky-light ml-2">
        ／ お電話 <Icon name="phone" size={12} /> 059-271-5908
      </span>
    </div>
  )
}
